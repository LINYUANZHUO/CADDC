                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="图片 DPI 直接应用于着色/光栅输出；矢量与光栅目标值会保存，最终上限仍受所选 PC3 驱动配置约束。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,12,0,0" Header="C. 识别规则" Padding="12" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}">
