                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid x:Name="BoardModuleView" Visibility="Collapsed">
            <TabControl Background="#F5F6F8">
                <TabItem Header="板件">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8">
                            <GroupBox Header="全局与标识设置" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="全局板厚 (mm)" />
                                    <TextBox x:Name="BoardThicknessBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="18" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="标识比例 (0.1-10)" />
                                    <TextBox x:Name="BoardTagScaleBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="5" />
                                    <TextBlock Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center" Text="标识类型" />
                                    <ComboBox x:Name="BoardTagTypeCombo" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Height="30" SelectedIndex="0">
                                        <ComboBoxItem Content="活动层板带文字" />
                                        <ComboBoxItem Content="活动层板" />
                                        <ComboBoxItem Content="固定板件" />
                                    </ComboBox>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="常规板件绘制" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="板件深度 (mm)" />
                                    <TextBox x:Name="BoardDepthBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="500" />
                                    <Button Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="绘制板件 (DCCB)" Click="OnDrawBoardClick" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="空间中分板件" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="中分板深度 (mm)" />
                                    <TextBox x:Name="BoardCenterDepthBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="500" />
                                    <Button Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="中分板件 (DCZC)" Click="OnDrawCenterBoardClick" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="位移与夹层" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <StackPanel>
                                    <Button Style="{StaticResource DoorPanelCompactActionStyle}" Content="位移板 (DCYC)" Click="OnDisplaceBoardClick" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="A层厚度" /><TextBox x:Name="AbaOuterThicknessBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="18" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="B层厚度" /><TextBox x:Name="AbaCoreThicknessBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="9" />
                                        <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="夹层深度" /><TextBox x:Name="AbaDepthBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="500" />
                                        <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="ABA夹层 (DCABA)" Click="OnAbaBoardClick" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="均分板件" Style="{StaticResource DoorPanelCompactGroupStyle}">
