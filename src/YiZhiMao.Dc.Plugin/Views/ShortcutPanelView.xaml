                                                     Content="等分" />
                                        <RadioButton x:Name="BackgroundWallRandomRadio"
                                                     VerticalAlignment="Center"
                                                     Foreground="#20242A"
                                                     GroupName="BackgroundWallWidthMode"
                                                     IsChecked="True"
                                                     Content="随机" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Margin="0,10,0,0"
                                      Header="规格参数 (mm)"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="总宽度" />
                                    <TextBox x:Name="BackgroundWallWidthBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="2400" />
                                    <TextBlock Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="厚/深" />
                                    <TextBox x:Name="BackgroundWallDepthBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="18" />
                                    <TextBlock Grid.Row="1" Margin="0,6,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="缝隙" />
                                    <TextBox x:Name="BackgroundWallGapBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource FormTextBoxStyle}" Text="3" />
                                    <CheckBox x:Name="BackgroundWallSlotCheck"
                                              Grid.Row="1"
                                              Grid.Column="3"
                                              Grid.ColumnSpan="2"
                                              Margin="0,6,0,0"
                                              VerticalAlignment="Center"
                                              Foreground="#20242A"
                                              IsChecked="True"
                                              Content="在每条板缝生成俯视卡槽 (25×5)" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Margin="0,10,0,0"
                                      Header="每排详细配置"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="横向排数" />
                                        <ComboBox x:Name="BackgroundWallRowCountCombo"
                                                  Grid.Column="1"
                                                  Height="30"
                                                  VerticalContentAlignment="Center"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnBackgroundWallRowCountChanged">
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                            <ComboBoxItem Content="3" />
                                            <ComboBoxItem Content="4" />
                                            <ComboBoxItem Content="5" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Margin="0,10,0,4" Foreground="#68707C" Text="列表顺序由下往上；首排为底、末排为顶，中间排为中。" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="68" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="68" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="#68707C" Text="列数" />
                                        <TextBlock Grid.Column="4" HorizontalAlignment="Center" Foreground="#68707C" Text="高度" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="68" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="68" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow1Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第一排(底)" />
                                        <TextBox x:Name="BackgroundWallRow1ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow1HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow2Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第二排" />
                                        <TextBox x:Name="BackgroundWallRow2ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow2HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow3" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow3Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第三排" />
                                        <TextBox x:Name="BackgroundWallRow3ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow3HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow4" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow4Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第四排" />
                                        <TextBox x:Name="BackgroundWallRow4ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow4HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow5" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow5Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第五排" />
                                        <TextBox x:Name="BackgroundWallRow5ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow5HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <Button Margin="0,12,0,0"
                                    Height="38"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Content="生成背景墙 (DCBJQ)"
                                    Click="OnDrawBackgroundWallClick" />
                            <TextBlock x:Name="BackgroundWallStatusText"
                                       Margin="0,8,0,0"
                                       Foreground="#68707C"
                                       TextWrapping="Wrap"
                                       Text="俯视大板与立面板缝保持一致；卡槽按板缝中心生成，末块板不生成卡槽。" />
