<Window x:Class="YiZhiMao.Dc.Plugin.Views.PdfToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一只猫dc PDF 工具"
        Width="700"
        Height="610"
        MinWidth="600"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F7F7F8"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#EF5E25" />
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" Text="PDF 自由合并工具" />
            <TextBlock Margin="0,5,0,12" Foreground="#7A818B" Text="选择来源目录，勾选需要的文件后按当前列表顺序合并。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="来源目录：" />
            <TextBox x:Name="SourceFolderBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource ButtonStyle}" Content="扫描" Click="OnScanClick" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="输出目录：" />
            <TextBox x:Name="OutputFolderBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource ButtonStyle}" Content="选择" Click="OnChooseOutputClick" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource ButtonStyle}" Margin="0" Content="全选" Click="OnSelectAllClick" />
                <Button Style="{StaticResource ButtonStyle}" Content="反选" Click="OnInvertClick" />
            </StackPanel>
            <DataGrid x:Name="PdfGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#D9DDE3"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="勾选" Binding="{Binding IsSelected}" Width="70" />
                    <DataGridTextColumn Header="文件名称" Binding="{Binding FileName}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="页数" Binding="{Binding PageCount}" IsReadOnly="True" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource ButtonStyle}" Margin="0" Content="清空列表" Click="OnClearClick" />
            <TextBlock x:Name="PdfStatusText" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="#68707C" TextWrapping="Wrap" />
            <Button Grid.Column="2" Style="{StaticResource ButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Content="开始合并所选文件" Click="OnMergeClick" />
        </Grid>
    </Grid>
</Window>
