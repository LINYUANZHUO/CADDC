                            <TextBlock Grid.Row="1" Margin="0,5,0,0" VerticalAlignment="Center" Text="柜体选择 (DCX2)" />
                            <ComboBox x:Name="DrawingLayerCabinetSelectionBox" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" IsEditable="True" Style="{StaticResource DoorPanelCompactComboStyle}" />
                            <Button Grid.Row="1" Grid.Column="3" Margin="0,5,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Content="选择柜体" Click="OnSelectCabinetLayerClick" />
                            <TextBlock Grid.Row="2" Margin="0,5,0,0" VerticalAlignment="Center" Text="自定义一 (DCX3)" />
                            <ComboBox x:Name="DrawingLayerCustomSelectionOneBox" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" IsEditable="True" Style="{StaticResource DoorPanelCompactComboStyle}" />
                            <Button Grid.Row="2" Grid.Column="3" Margin="0,5,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Content="选择一" Click="OnSelectCustomLayerOneClick" />
                            <TextBlock Grid.Row="3" Margin="0,5,0,0" VerticalAlignment="Center" Text="自定义二 (DCX4)" />
                            <ComboBox x:Name="DrawingLayerCustomSelectionTwoBox" Grid.Row="3" Grid.Column="1" Margin="0,5,0,0" IsEditable="True" Style="{StaticResource DoorPanelCompactComboStyle}" />
                            <Button Grid.Row="3" Grid.Column="3" Margin="0,5,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Content="选择二" Click="OnSelectCustomLayerTwoClick" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource DoorPanelCompactActionStyle}" Content="选择所有标注 (DCX5)" Click="OnSelectAllAnnotationsClick" />
                            <Button Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="选择类似对象 (DCXZ)" Click="OnSelectSimilarObjectsClick" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="图纸显示修复" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="全局虚线比例" />
                        <TextBox x:Name="DrawingLinetypeScaleBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="40" />
                        <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="墙体填充比例" />
                        <TextBox x:Name="WallHatchScaleBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="1" />
                        <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="一键修复显示 (DCTXF)" Click="OnRepairDrawingDisplayClick" />
                    </Grid>
                </GroupBox>
                <TextBlock x:Name="DrawingLayerStatusText" Margin="0,6,0,0" Foreground="#68707C" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="OneClickFrameModuleView"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <GroupBox Header="1. 图框模板" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Foreground="#68707C" Text="选择 DWG 模板" />
                        <ComboBox x:Name="FrameTemplateCombo"
                                  Grid.Row="2"
                                  Style="{StaticResource DoorPanelCompactComboStyle}"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Content="📁"
                                ToolTip="选择外部 DWG 图框模板"
                                Click="OnBrowseFrameTemplateClick" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="2. 图框放置" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <TextBlock Foreground="#68707C" Text="图形到图框的距离 (mm)" />
                        <TextBox x:Name="FrameMarginBox" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="50" />
                        <CheckBox x:Name="FramePageStatisticsCheck" Margin="0,7,0,0" Content="生成页面统计" />
                        <Button Margin="0,7,0,0"
                                Height="38"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                Content="一键加框 (DCTK)"
                                Click="OnAutoFrameClick" />
                        <TextBlock Margin="0,5,0,0" Foreground="#8A929D" TextWrapping="Wrap" Text="自动读取模板中面积最大的闭合矩形作为图框范围。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3. 图框对齐方式" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <RadioButton x:Name="FrameAlignLeftRadio" GroupName="FrameAlignment" IsChecked="True" Content="左对齐（拾取竖线）" />
                        <RadioButton x:Name="FrameAlignBottomRadio" Margin="0,5,0,0" GroupName="FrameAlignment" Content="下对齐（拾取横线）" />
                        <TextBlock Margin="0,7,0,0" Foreground="#68707C" Text="左右排列间距 (mm)" />
                        <TextBox x:Name="FrameHorizontalGapBox" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="100" />
                        <TextBlock Margin="0,7,0,0" Foreground="#68707C" Text="上下排列间距 (mm)" />
                        <TextBox x:Name="FrameVerticalGapBox" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="100" />
                        <Button Margin="0,7,0,0"
                                Height="36"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                Content="图框对齐 (DCDQ)"
                                Click="OnAlignFrameClick" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="局部放大（大样图）" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="形状" />
                            <RadioButton x:Name="DetailCircleRadio" GroupName="DetailShape" IsChecked="True" Content="圆形" />
                            <RadioButton x:Name="DetailRectangleRadio" Margin="12,0,0,0" GroupName="DetailShape" Content="矩形" />
                        </StackPanel>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="放大倍数" />
                            <TextBox x:Name="DetailScaleBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="3" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="矩形圆角 r" />
                            <TextBox x:Name="DetailCornerRadiusBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="10" />
                        </Grid>
                        <Button Margin="0,7,0,0"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                Content="选择区域生成大样 (DCFD)"
                                Click="OnDetailDrawClick" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="局部截图" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="截图倍数" />
                            <TextBox x:Name="ClipScaleBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="1" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="矩形圆角 r" />
                            <TextBox x:Name="ClipCornerRadiusBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="10" />
                        </Grid>
                        <Button Margin="0,7,0,0"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Background="#2E925B"
                                BorderBrush="#2E925B"
                                Foreground="White"
                                Content="选择区域局部截图 (DCJT)"
                                Click="OnDetailClipClick" />
                        <TextBlock Margin="0,5,0,0" Foreground="#8A929D" TextWrapping="Wrap" Text="截图内容生成独立块，并应用矩形裁剪边界。" />
                    </StackPanel>
                </GroupBox>
                <TextBlock x:Name="FrameStatusText" Margin="0,6,0,4" Foreground="#68707C" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="RadialMenuModuleView"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <CheckBox x:Name="RadialMenuEnabledCheck"
                          Margin="2,2,0,3"
                          FontWeight="SemiBold"
                          Content="启用圆盘工具" />

                <GroupBox Header="圆盘全局设置" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="RadialMenuAutoCloseCheck" Grid.ColumnSpan="2" Content="执行命令后自动关闭圆盘" />
                        <CheckBox x:Name="RadialMenuThirdRingCheck" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Content="显示第三圈（最外圈）" />
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="圆盘大小" />
                        <Slider x:Name="RadialMenuSizeSlider" Grid.Row="2" Margin="80,8,0,0" Minimum="120" Maximum="320" TickFrequency="10" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="5,8,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ElementName=RadialMenuSizeSlider, Path=Value, StringFormat={}{0:0}}" />
                        <TextBlock Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Center" Text="透明度" />
                        <Slider x:Name="RadialMenuOpacitySlider" Grid.Row="3" Margin="80,8,0,0" Minimum="0.35" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="5,8,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ElementName=RadialMenuOpacitySlider, Path=Value, StringFormat={}{0:0.00}}" />
                        <TextBlock Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Center" Text="外观皮肤" />
                        <ComboBox x:Name="RadialMenuSkinCombo" Grid.Row="4" Grid.ColumnSpan="2" Margin="80,8,0,0" Style="{StaticResource DoorPanelCompactComboStyle}" SelectionChanged="OnRadialMenuSkinSelectionChanged">
                            <ComboBoxItem Content="橙灰极简 (Orange Slate)" />
                            <ComboBoxItem Content="CAD 深色" />
                            <ComboBoxItem Content="紫灰" />
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <GroupBox Header="快捷命令配置" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,5" Foreground="{StaticResource AccentBrush}" Text="提示：拖拽行可在同圈内调整顺序，双击名称或快捷键可编辑" TextWrapping="Wrap" />
                        <DataGrid x:Name="RadialMenuGrid"
                                  Height="560"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                                  RowStyle="{StaticResource ShortcutRowStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="OnRadialMenuGridMouseDown"
                                  MouseMove="OnRadialMenuGridMouseMove"
                                  Drop="OnRadialMenuGridDrop">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="位置" Width="0.8*" MinWidth="86" IsReadOnly="True" Binding="{Binding PositionLabel}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="命令名称" Width="1.6*" MinWidth="140" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="CAD快捷键" Width="1*" MinWidth="105" Binding="{Binding CommandAlias, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource DoorPanelCompactActionStyle}" Content="打开圆盘 (DCYP)" Click="OnOpenRadialMenuClick" />
                            <Button Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="保存并应用配置" Click="OnSaveRadialMenuClick" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <TextBlock x:Name="RadialMenuStatusText" Margin="0,6,0,4" Foreground="#68707C" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="LispMarketModuleView"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,8,10,10">
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           Foreground="#20242A"
                           Text="CAD LISP 插件市场" />
                <TextBlock Margin="0,4,0,3"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           Text="三步极速上手，支持 AutoCAD 2004~2027" />
                <TextBlock Margin="0,0,0,3"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="默认读取随插件安装的本地资源库，无需联网即可加载。" />

                <GroupBox Header="默认本地 LISP 库" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource DoorPanelCompactActionStyle}"
                                    Content="刷新列表"
                                    Click="OnRefreshLispLibraryClick" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource DoorPanelCompactActionStyle}"
                                    Content="打开本地目录"
                                    Click="OnOpenLispLibraryClick" />
                        </Grid>

                        <Border Margin="0,7,0,0"
                                Height="230"
                                Background="White"
                                BorderBrush="#D9DDE3"
                                BorderThickness="1">
                            <DataGrid x:Name="LispPluginGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0"
                                      RowStyle="{StaticResource ShortcutRowStyle}"
                                      CellStyle="{StaticResource GridCellStyle}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="插件名称" Binding="{Binding Name}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" Width="1.15*" MinWidth="120" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" Width="0.65*" MinWidth="60" />
                                    <DataGridTextColumn Header="本地路径" Binding="{Binding RelativePath}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" Width="2*" MinWidth="150" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" Width="0.75*" MinWidth="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Button Margin="0,7,0,0"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="加载选中插件"
                                Click="OnLoadSelectedLispClick" />
                        <TextBlock x:Name="LispMarketStatusText"
                                   Margin="0,6,0,0"
                                   Foreground="#68707C"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="方法一：拖入即用（最快）" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#20242A"
                                   Text="下载 .lsp 文件后，直接将文件从桌面或文件夹拖入正在运行的 CAD 绘图窗口中释放。" />
                        <TextBlock Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#68707C"
                                   Text="命令行显示加载成功后，键入插件对应快捷键（例如 ZD）即可运行。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="方法二：APPLOAD 命令加载" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="#20242A"
                               Text="在 CAD 命令行输入 APPLOAD 并回车，在弹出的对话框中选中下载的 .lsp 文件，再点击右下角“加载”按钮。" />
                </GroupBox>

                <GroupBox Header="方法三：随 CAD 开机自启（推荐）" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#20242A"
                                   Text="在 APPLOAD 窗口右下角找到带书包图标的“启动组 (Startup Suite)”。" />
                        <TextBlock Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#68707C"
                                   Text="依次点击“内容 (Contents)” → “添加”，把常用 LISP 加入列表，以后每次启动 CAD 都会自动加载。" />
                    </StackPanel>
                </GroupBox>

                <Border Margin="0,8,0,0"
                        Padding="9,7"
                        Background="#FFF7F2"
                        BorderBrush="#F3C6B2"
                        BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock Foreground="#8A4A2E"
                               TextWrapping="Wrap"
                               Text="本地库支持 LSP、FAS、VLX 及分类子文件夹；加载只对当前 CAD 会话生效，不会自动修改启动组。" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
