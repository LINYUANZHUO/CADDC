                                        Content="保存俯视门板参数"
                                        Click="OnSavePlanDoorPanelOptionsClick" />
                            </Grid>
                            <TextBlock x:Name="PlanDoorPanelStatusText"
                                       Margin="0,6,0,0"
                                       Foreground="#68707C"
                                       TextWrapping="Wrap"
                                       Text="起终点确定柜体前沿；移动鼠标选择生成侧，R翻转，W/+、S/-调整门数。" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="抽面设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
