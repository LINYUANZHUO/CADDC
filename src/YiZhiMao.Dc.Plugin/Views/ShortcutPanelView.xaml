                        <GroupBox Header="普通门板统计" Style="{StaticResource DoorPanelCompactGroupStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#68707C" TextWrapping="Wrap" Text="框选门板或抽面，按名称、宽高和厚度汇总并导出 CSV。" />
                                <Button Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="开始门板统计 (DCTJM)" Click="OnDoorStatisticsClick" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
                <TabItem Header="边框门板">
                    <StackPanel Margin="8">
                        <GroupBox Header="边框门板统计" Style="{StaticResource DoorPanelCompactGroupStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#68707C" TextWrapping="Wrap" Text="识别图层或块名称中包含“门板”且包含“边框/玻璃”的对象。" />
                                <Button Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="开始边框门板统计 (DCBKM)" Click="OnFrameDoorStatisticsClick" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
                <TabItem Header="柜体拆单">
                    <StackPanel Margin="8">
                        <GroupBox Header="柜体板件明细" Style="{StaticResource DoorPanelCompactGroupStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#68707C" TextWrapping="Wrap" Text="框选柜体结构、层板与背板，按实际包围尺寸汇总板件明细。" />
                                <Button Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="开始柜体拆单 (DCTJG)" Click="OnCabinetBomClick" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
                <TabItem Header="板件统计">
                    <StackPanel Margin="8">
                        <GroupBox Header="板件规格统计" Style="{StaticResource DoorPanelCompactGroupStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#68707C" TextWrapping="Wrap" Text="输出板件规格、数量和面积。当前版本不把面积换算冒充精确开料排版。" />
