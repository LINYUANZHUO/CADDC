                            <TextBox x:Name="VectorDpiBox" Grid.Column="2" Height="28" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="1" Margin="0,5" VerticalAlignment="Center" Foreground="#20242A" Text="光栅分辨率" />
                            <Slider x:Name="GradientDpiSlider" Grid.Row="1" Grid.Column="1" Margin="10,0" Minimum="72" Maximum="4800" TickFrequency="72" ValueChanged="OnDpiSliderChanged" />
                            <TextBox x:Name="GradientDpiBox" Grid.Row="1" Grid.Column="2" Height="28" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="2" Margin="0,5" VerticalAlignment="Center" Foreground="#20242A" Text="图片分辨率" />
                            <Slider x:Name="ImageDpiSlider" Grid.Row="2" Grid.Column="1" Margin="10,0" Minimum="72" Maximum="4800" TickFrequency="72" ValueChanged="OnDpiSliderChanged" />
                            <TextBox x:Name="PrintImageDpiBox" Grid.Row="2" Grid.Column="2" Height="28" VerticalContentAlignment="Center" />
