                            <GroupBox Header="排列与缝隙"
                                      Margin="0"
                                      Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="排列方向" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="DrawerFaceVerticalRadio"
                                                     Margin="0,0,14,0"
                                                     Foreground="#20242A"
                                                     IsChecked="True"
                                                     Content="竖向" />
                                        <RadioButton x:Name="DrawerFaceHorizontalRadio"
                                                     Foreground="#20242A"
                                                     Content="横向" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="抽面数量" />
                                    <TextBox x:Name="DrawerFaceCountBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             Margin="0,4,0,0"
                                             Style="{StaticResource DoorPanelCompactInputStyle}"
                                             Text="2" />
                                    <TextBlock Grid.Row="2" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="固定缝隙 (mm)" />
                                    <ComboBox x:Name="DrawerFaceGapBox"
                                              Grid.Row="2"
                                              Grid.Column="1"
                                              Margin="0,4,0,0"
                                              IsEditable="True"
                                              Style="{StaticResource DoorPanelCompactComboStyle}"
                                              Text="3">
                                        <ComboBoxItem Content="0.5" />
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="1.5" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="2.5" />
                                        <ComboBoxItem Content="3" />
                                        <ComboBoxItem Content="3.5" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="4.5" />
                                        <ComboBoxItem Content="5" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="尺寸计算模式" />
                                    <ComboBox x:Name="DrawerFaceCalculationModeCombo" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactComboStyle}" SelectedIndex="1">
                                        <ComboBoxItem Tag="DoorRoundedGapDistributed" Content="门取整，缝均分" />
                                        <ComboBoxItem Tag="GapRoundedDoorDistributed" Content="缝取整，门均分" />
                                        <ComboBoxItem Tag="DoorAndGapRoundedRemainderRight" Content="门和缝取整，余量留终点" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="4" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="线条颜色 (ACI)" />
                                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DrawerFaceColorBox" IsEditable="True" Style="{StaticResource DoorPanelCompactComboStyle}" Text="3">
                                            <ComboBoxItem Content="3 - 绿色" /><ComboBoxItem Content="7 - 白色" /><ComboBoxItem Content="249 - 灰色" />
                                        </ComboBox>
                                        <Button Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="调色…" Click="OnDrawerFaceColorClick" />
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="四向盖值" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="上盖 (mm)" />
                                    <TextBox x:Name="DrawerFaceTopExtensionBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#20242A" Text="下盖 (mm)" />
                                    <TextBox x:Name="DrawerFaceBottomExtensionBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="左盖 (mm)" />
                                    <TextBox x:Name="DrawerFaceLeftExtensionBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="右盖 (mm)" />
                                    <TextBox x:Name="DrawerFaceRightExtensionBox" Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="遮罩与拉手" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="DrawerFaceGenerateMaskCheck"
                                              Margin="0,2"
                                              Foreground="#20242A"
                                              Content="生成抽屉背景遮罩 (Wipeout)" />
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource DoorPanelCompactActionStyle}" Content="拾取拉手 (DCSDH)" Click="OnPickHandleClick" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                                Background="{StaticResource AccentBrush}"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                Foreground="White"
                                                Content="应用/替换拉手 (DCLAS)"
                                                Click="OnApplyHandleClick" />
                                    </Grid>
                                    <TextBlock x:Name="PickedHandleText" Margin="0,4,0,0" Foreground="#68707C" Text="当前拉手：未拾取" />
                                </StackPanel>
                            </GroupBox>

                            <Border Margin="0,8,0,0"
                                    Padding="8"
                                    BorderBrush="#D7DBE0"
                                    BorderThickness="1"
                                    Background="White">
                                <TextBlock x:Name="DrawerFaceActualSizeText"
                                           Foreground="#20242A"
                                           TextWrapping="Wrap"
                                           Text="实际单块尺寸/缝隙：—（选择柜体内空后计算）" />
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource DoorPanelCompactActionStyle}"
                                        Background="{StaticResource AccentBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Content="生成抽面 (DCMC)"
                                        Click="OnGenerateDrawerFacesClick" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource DoorPanelCompactActionStyle}"
                                        Background="#E9EBEE"
                                        BorderBrush="#C9CDD3"
                                        Foreground="#20242A"
                                        Content="保存抽面参数"
                                        Click="OnSaveDrawerFaceOptionsClick" />
                            </Grid>
                            <TextBlock x:Name="DrawerFaceStatusText"
                                       Margin="0,6,0,0"
                                       Foreground="#68707C"
                                       TextWrapping="Wrap"
                                       Text="依次选择柜体内空两个对角点；左右键或 +/- 调整数量，竖向也可用上下键。" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid x:Name="HardwareModuleView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TabControl Background="#F5F6F8"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource TopTabStyle}"
                        Padding="0">
            <TabItem Header="挂衣杆设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0,0,0,6" Foreground="#20242A" Text="样式预览" />
                        <Border Height="150" Background="#252525" CornerRadius="2">
                            <Grid>
                                <Image x:Name="HangingRodPreviewImage" Stretch="Uniform" Margin="8" />
                                <TextBlock x:Name="HangingRodPreviewHint"
                                           Foreground="#BFC4CB"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="未选择素材" />
                            </Grid>
                        </Border>

                        <GroupBox Margin="0,12,0,0" Header="参数设置" Padding="12" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="离顶高度 (mm)：" />
                                <TextBox x:Name="HangingRodTopOffsetBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="100" />
                            </Grid>
                        </GroupBox>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#737B86"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="选择柜内净空闭合矩形；挂衣杆按净宽左右各减 4mm，并应用离顶高度。" />

                        <TextBlock Margin="0,12,0,5" Foreground="#20242A" FontWeight="SemiBold" Text="本地图库 (HangingRodBlocks)" />
                        <ListBox x:Name="HangingRodList"
                                 Height="132"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="OnHardwareSelectionChanged" />
                        <Button Margin="0,12,0,0"
                                Height="38"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="插入挂衣杆 (DCYG)"
                                Click="OnInsertHangingRodClick" />
                        <Button Margin="0,8,0,0"
                                Height="34"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#4CAF50"
                                BorderBrush="#4CAF50"
                                Foreground="White"
                                Content="打开图库目录"
                                Click="OnOpenHangingRodDirectoryClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="灯带设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0,0,0,6" Foreground="#20242A" Text="灯带预览" />
                        <Border Height="150" Background="#252525" CornerRadius="2">
                            <Grid>
                                <Image x:Name="LightStripPreviewImage" Stretch="Uniform" Margin="8" />
                                <TextBlock x:Name="LightStripPreviewHint"
                                           Foreground="#BFC4CB"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="未选择素材" />
                            </Grid>
                        </Border>

                        <GroupBox Margin="0,12,0,0" Header="安装参数" Padding="12" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,8,7" VerticalAlignment="Center" Foreground="#20242A" Text="距顶深度 (mm)：" />
                                <TextBox x:Name="LightStripTopOffsetBox" Grid.Column="1" Margin="0,0,0,7" Style="{StaticResource FormTextBoxStyle}" Text="10" />
                                <TextBlock Grid.Row="1" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="侧视图距前口 (mm)：" />
                                <TextBox x:Name="LightStripSideOpeningBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="100" />
                            </Grid>
                        </GroupBox>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#737B86"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="当前基础版按 DWG 原尺寸插入；安装偏移将在柜体自动识别规则确认后启用。" />

                        <TextBlock Margin="0,12,0,5" Foreground="#20242A" FontWeight="SemiBold" Text="本地图库 (LightStripBlocks)" />
                        <ListBox x:Name="LightStripList"
                                 Height="132"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="OnHardwareSelectionChanged" />
                        <Button Margin="0,12,0,0"
                                Height="38"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="插入灯带 (DD)"
                                Click="OnInsertLightStripClick" />
                        <Button Margin="0,8,0,0"
                                Height="34"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#4CAF50"
                                BorderBrush="#4CAF50"
                                Foreground="White"
                                Content="打开图库目录"
                                Click="OnOpenLightStripDirectoryClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="铰链设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <GroupBox Header="铰链设置"
                                  Margin="0"
                                  Padding="8"
                                  BorderBrush="{StaticResource AccentBrush}"
                                  Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="距门顶" />
                                <TextBox x:Name="HardwareHingeTopOffsetBox"
                                         Grid.Column="1"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeTopOffsetBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#20242A" Text="距门底" />
                                <TextBox x:Name="HardwareHingeBottomOffsetBox"
                                         Grid.Column="4"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeBottomOffsetBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="H&lt;0.9m数" />
                                <TextBox x:Name="HardwareHingeCountBelow900Box"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeCountBelow900Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="0.9-1.5m数" />
                                <TextBox x:Name="HardwareHingeCount900To1500Box"
                                         Grid.Row="1"
                                         Grid.Column="4"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeCount900To1500Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="1.5-2.0m数" />
                                <TextBox x:Name="HardwareHingeCount1500To2000Box"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeCount1500To2000Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="2.0-2.5m数" />
                                <TextBox x:Name="HardwareHingeCount2000To2500Box"
                                         Grid.Row="2"
                                         Grid.Column="4"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeCount2000To2500Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="H≥2.5m数" />
                                <TextBox x:Name="HardwareHingeCountAtLeast2500Box"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeCountAtLeast2500Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="HardwareUseFixedHingeSpacingCheck"
                                          Grid.Row="3"
                                          Grid.Column="3"
                                          Margin="0,4,0,0"
                                          VerticalAlignment="Center"
                                          Foreground="#20242A"
                                          Content="固定间距"
                                          IsChecked="{Binding IsChecked, ElementName=UseFixedHingeSpacingCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="HardwareFixedHingeSpacingBox"
                                         Grid.Row="3"
                                         Grid.Column="4"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=FixedHingeSpacingBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="尺寸标注选项"
                                  Margin="0,8,0,0"
                                  Padding="8"
                                  BorderBrush="{StaticResource AccentBrush}"
                                  Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="HardwareGenerateHingeDimensionsCheck"
                                          VerticalAlignment="Center"
                                          Foreground="#20242A"
                                          Content="生成尺寸标注"
                                          IsChecked="{Binding IsChecked, ElementName=GenerateHingeDimensionsCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="HardwareHingeDimensionModeCombo"
                                          Grid.Column="1"
                                          Height="30"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          SelectedIndex="{Binding SelectedIndex, ElementName=HingeDimensionModeCombo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Tag="Continuous" Content="连续标注" />
                                    <ComboBoxItem Tag="SplitFromEnds" Content="上下定位" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="首层距门边 (mm)" />
                                <TextBox x:Name="HardwareHingeDimensionOffsetBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeDimensionOffsetBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="多层标注间距 (mm)" />
                                <TextBox x:Name="HardwareHingeDimensionLineSpacingBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeDimensionLineSpacingBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="标注文字高度 (mm)" />
                                <TextBox x:Name="HardwareHingeDimensionTextHeightBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeDimensionTextHeightBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="铰链类型文字"
                                  Margin="0,8,0,0"
                                  Padding="8"
                                  BorderBrush="{StaticResource AccentBrush}"
                                  Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="文字高度 (mm)" />
                                <TextBox x:Name="HardwareHingeTypeTextHeightBox"
                                         Grid.Column="1"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeTypeTextHeightBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="距铰链圆间距 (mm)" />
                                <TextBox x:Name="HardwareHingeTypeTextSpacingBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Height="30"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Text="{Binding Text, ElementName=HingeTypeTextSpacingBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Height="32"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Content="保存铰链参数"
                                    Click="OnSaveHardwareHingeOptionsClick" />
                            <Button Grid.Column="2"
                                    Height="32"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="#E9EBEE"
                                    BorderBrush="#C9CDD3"
                                    Foreground="#20242A"
                                    Content="单独插入铰链 (JL)"
                                    Click="OnHardwareInsertHingesClick" />
                            <Button Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Height="32"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="#E9EBEE"
                                    BorderBrush="#C9CDD3"
                                    Foreground="#20242A"
                                    Content="标记铰链种类 (DCHJL)"
                                    Click="OnHardwareLabelHingesClick" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            </TabControl>

            <Border x:Name="HardwareStatusBar"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Margin="12,6,12,12"
                    Padding="8"
                    Background="#FFFDFB"
                    BorderBrush="#E5E8EC"
                    BorderThickness="1">
                <TextBlock x:Name="HardwareStatusText" Foreground="#68707C" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Grid x:Name="WallPanelModuleView" Visibility="Collapsed">
            <TabControl Background="#F5F6F8"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource TopTabStyle}"
                        Padding="0">
                <TabItem Header="格栅板">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <GroupBox Header="基本配置"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#20242A"
                                                   Text="排列方向：" />
                                        <RadioButton x:Name="GrilleVerticalRadio"
                                                     Margin="0,0,16,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#20242A"
                                                     GroupName="GrilleDirection"
                                                     IsChecked="True"
                                                     Content="竖向" />
                                        <RadioButton x:Name="GrilleHorizontalRadio"
                                                     VerticalAlignment="Center"
                                                     Foreground="#20242A"
                                                     GroupName="GrilleDirection"
                                                     Content="横向" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox x:Name="GrillePlanViewCheck"
