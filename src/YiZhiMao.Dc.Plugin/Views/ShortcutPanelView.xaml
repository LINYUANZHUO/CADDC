                                    <Button Grid.Row="3" Grid.ColumnSpan="5" Margin="0,5,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="生成背板 (DCBB)" Click="OnBackboardClick" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="板件编辑与投影" Style="{StaticResource DoorPanelCompactGroupStyle}">
