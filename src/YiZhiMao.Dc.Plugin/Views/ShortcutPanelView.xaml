                                 Height="132"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="OnHardwareSelectionChanged" />
                        <Button Margin="0,12,0,0"
                                Height="38"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="插入挂衣杆 (DCYG)"
                                Click="OnInsertHangingRodClick" />
                        <Button Margin="0,8,0,0"
                                Height="34"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#4CAF50"
                                BorderBrush="#4CAF50"
                                Foreground="White"
                                Content="打开图库目录"
                                Click="OnOpenHangingRodDirectoryClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="灯带设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Margin="0,0,0,6" Foreground="#20242A" Text="灯带预览" />
                        <Border Height="150" Background="#252525" CornerRadius="2">
                            <Grid>
                                <Image x:Name="LightStripPreviewImage" Stretch="Uniform" Margin="8" />
                                <TextBlock x:Name="LightStripPreviewHint"
                                           Foreground="#BFC4CB"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="未选择素材" />
                            </Grid>
                        </Border>

                        <GroupBox Margin="0,12,0,0" Header="安装参数" Padding="12" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,8,7" VerticalAlignment="Center" Foreground="#20242A" Text="距顶深度 (mm)：" />
                                <TextBox x:Name="LightStripTopOffsetBox" Grid.Column="1" Margin="0,0,0,7" Style="{StaticResource FormTextBoxStyle}" Text="10" />
                                <TextBlock Grid.Row="1" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="侧视图距前口 (mm)：" />
                                <TextBox x:Name="LightStripSideOpeningBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="100" />
                            </Grid>
                        </GroupBox>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#737B86"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="当前基础版按 DWG 原尺寸插入；安装偏移将在柜体自动识别规则确认后启用。" />

                        <TextBlock Margin="0,12,0,5" Foreground="#20242A" FontWeight="SemiBold" Text="本地图库 (LightStripBlocks)" />
                        <ListBox x:Name="LightStripList"
                                 Height="132"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="OnHardwareSelectionChanged" />
                        <Button Margin="0,12,0,0"
                                Height="38"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="插入灯带 (DCDD)"
                                Click="OnInsertLightStripClick" />
                        <Button Margin="0,8,0,0"
                                Height="34"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#4CAF50"
                                BorderBrush="#4CAF50"
                                Foreground="White"
                                Content="打开图库目录"
                                Click="OnOpenLightStripDirectoryClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="铰链设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <GroupBox Header="铰链设置"
                                  Margin="0"
                                  Padding="8"
                                  BorderBrush="{StaticResource AccentBrush}"
                                  Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="距门顶" />
                                <TextBox x:Name="HardwareHingeTopOffsetBox"
                                         Grid.Column="1"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeTopOffsetBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#20242A" Text="距门底" />
                                <TextBox x:Name="HardwareHingeBottomOffsetBox"
                                         Grid.Column="4"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeBottomOffsetBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="H&lt;0.9m数" />
                                <TextBox x:Name="HardwareHingeCountBelow900Box"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeCountBelow900Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="0.9-1.5m数" />
                                <TextBox x:Name="HardwareHingeCount900To1500Box"
                                         Grid.Row="1"
                                         Grid.Column="4"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeCount900To1500Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="1.5-2.0m数" />
                                <TextBox x:Name="HardwareHingeCount1500To2000Box"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeCount1500To2000Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="2.0-2.5m数" />
                                <TextBox x:Name="HardwareHingeCount2000To2500Box"
                                         Grid.Row="2"
                                         Grid.Column="4"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeCount2000To2500Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="H≥2.5m数" />
                                <TextBox x:Name="HardwareHingeCountAtLeast2500Box"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeCountAtLeast2500Box, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="HardwareUseFixedHingeSpacingCheck"
                                          Grid.Row="3"
                                          Grid.Column="3"
                                          Margin="0,4,0,0"
                                          VerticalAlignment="Center"
                                          Foreground="#20242A"
                                          Content="固定间距"
                                          IsChecked="{Binding IsChecked, ElementName=UseFixedHingeSpacingCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="HardwareFixedHingeSpacingBox"
                                         Grid.Row="3"
                                         Grid.Column="4"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=FixedHingeSpacingBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="尺寸标注选项"
                                  Margin="0,8,0,0"
                                  Padding="8"
                                  BorderBrush="{StaticResource AccentBrush}"
                                  Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="HardwareGenerateHingeDimensionsCheck"
                                          VerticalAlignment="Center"
                                          Foreground="#20242A"
                                          Content="生成尺寸标注"
                                          IsChecked="{Binding IsChecked, ElementName=GenerateHingeDimensionsCheck, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="HardwareHingeDimensionModeCombo"
                                          Grid.Column="1"
                                          Height="30"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          SelectedIndex="{Binding SelectedIndex, ElementName=HingeDimensionModeCombo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Tag="Continuous" Content="连续标注" />
                                    <ComboBoxItem Tag="SplitFromEnds" Content="上下定位" />
                                </ComboBox>
                                <TextBlock Grid.Row="1" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="首层距门边 (mm)" />
                                <TextBox x:Name="HardwareHingeDimensionOffsetBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeDimensionOffsetBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="多层标注间距 (mm)" />
                                <TextBox x:Name="HardwareHingeDimensionLineSpacingBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeDimensionLineSpacingBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="标注文字高度 (mm)" />
                                <TextBox x:Name="HardwareHingeDimensionTextHeightBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeDimensionTextHeightBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="铰链类型文字"
                                  Margin="0,8,0,0"
                                  Padding="8"
                                  BorderBrush="{StaticResource AccentBrush}"
                                  Foreground="{StaticResource AccentBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="文字高度 (mm)" />
                                <TextBox x:Name="HardwareHingeTypeTextHeightBox"
                                         Grid.Column="1"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeTypeTextHeightBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Margin="0,4,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="距铰链圆间距 (mm)" />
                                <TextBox x:Name="HardwareHingeTypeTextSpacingBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,4,0,0"
                                         Style="{StaticResource HardwareInputStyle}"
                                         Text="{Binding Text, ElementName=HingeTypeTextSpacingBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </GroupBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Height="32"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Content="保存铰链参数"
                                    Click="OnSaveHardwareHingeOptionsClick" />
                            <Button Grid.Column="2"
                                    Height="32"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="#E9EBEE"
                                    BorderBrush="#C9CDD3"
                                    Foreground="#20242A"
                                    Content="单独插入铰链 (DCJL)"
                                    Click="OnHardwareInsertHingesClick" />
                            <Button Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Height="32"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="#E9EBEE"
                                    BorderBrush="#C9CDD3"
                                    Foreground="#20242A"
                                    Content="标记铰链种类 (DCHJL)"
                                    Click="OnHardwareLabelHingesClick" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            </TabControl>

            <Border x:Name="HardwareStatusBar"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Margin="12,6,12,12"
                    Padding="8"
                    Background="#FFFDFB"
                    BorderBrush="#E5E8EC"
                    BorderThickness="1">
                <TextBlock x:Name="HardwareStatusText" Foreground="#68707C" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Grid x:Name="WallPanelModuleView" Visibility="Collapsed">
            <TabControl Background="#F5F6F8"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource TopTabStyle}"
                        Padding="0">
                <TabItem Header="格栅板">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <GroupBox Header="基本配置"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#20242A"
                                                   Text="排列方向：" />
                                        <RadioButton x:Name="GrilleVerticalRadio"
                                                     Margin="0,0,16,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="#20242A"
                                                     GroupName="GrilleDirection"
                                                     IsChecked="True"
                                                     Content="竖向" />
                                        <RadioButton x:Name="GrilleHorizontalRadio"
                                                     VerticalAlignment="Center"
                                                     Foreground="#20242A"
                                                     GroupName="GrilleDirection"
                                                     Content="横向" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox x:Name="GrillePlanViewCheck"
                                                  Margin="0,0,18,0"
                                                  Foreground="#20242A"
                                                  Content="生成俯视图" />
                                        <CheckBox x:Name="GrilleSideViewCheck"
                                                  Foreground="#20242A"
                                                  Content="生成侧视图" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Margin="0,10,0,0"
                                      Header="规格参数 (mm)"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="总宽度" />
                                    <TextBox x:Name="GrilleWidthBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="1000" />
                                    <TextBlock Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="总高度" />
                                    <TextBox x:Name="GrilleHeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="2400" />

                                    <TextBlock Grid.Row="1" Margin="0,6,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="底板厚" />
                                    <TextBox x:Name="GrilleBackThicknessBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource FormTextBoxStyle}" Text="9" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="条厚" />
                                    <TextBox x:Name="GrilleStripThicknessBox" Grid.Row="1" Grid.Column="4" Margin="0,6,0,0" Style="{StaticResource FormTextBoxStyle}" Text="15" />

                                    <TextBlock Grid.Row="2" Margin="0,6,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="条宽" />
                                    <TextBox x:Name="GrilleStripWidthBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource FormTextBoxStyle}" Text="30" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,6,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="条间距" />
                                    <TextBox x:Name="GrilleStripGapBox" Grid.Row="2" Grid.Column="4" Margin="0,6,0,0" Style="{StaticResource FormTextBoxStyle}" Text="20" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Margin="0,10,0,0"
                                      Header="饰面效果"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="填充图案" />
                                    <ComboBox x:Name="GrilleHatchCombo"
                                              Grid.Column="1"
                                              Height="34"
                                              HorizontalContentAlignment="Left"
                                              VerticalContentAlignment="Center"
                                              SelectedIndex="0">
                                        <ComboBoxItem Tag="ANSI31" Content="ANSI31 (斜线)" />
                                        <ComboBoxItem Tag="ANSI32" Content="ANSI32 (双斜线)" />
                                        <ComboBoxItem Tag="ANSI37" Content="ANSI37 (点划线)" />
                                        <ComboBoxItem Tag="CROSS" Content="CROSS (网格)" />
                                        <ComboBoxItem Tag="DOTS" Content="DOTS (点状)" />
                                        <ComboBoxItem Tag="GRAVEL" Content="GRAVEL (碎石)" />
                                        <ComboBoxItem Tag="HONEY" Content="HONEY (六角蜂窝)" />
                                        <ComboBoxItem Tag="AR-B816" Content="AR-B816 (砖墙)" />
                                        <ComboBoxItem Tag="SOLID" Content="SOLID (实心)" />
                                        <ComboBoxItem Tag="无填充" Content="无填充" />
                                    </ComboBox>
                                </Grid>
                            </GroupBox>

                            <Button Margin="0,12,0,0"
                                    Height="38"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Content="生成格栅板 (DCGS)"
                                    Click="OnDrawGrilleClick" />
                            <Button Margin="0,8,0,0"
                                    Height="38"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Foreground="#20242A"
                                    FontWeight="SemiBold"
                                    Content="内空填充格栅 (DCGST)"
                                    Click="OnFillGrilleClick" />
                            <TextBlock x:Name="WallPanelStatusText"
                                       Margin="0,8,0,0"
                                       Foreground="#68707C"
                                       TextWrapping="Wrap"
                                       Text="DCGS 按设置尺寸指定左下角；DCGST 点击闭合内空并自动读取宽高。" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="洞洞板">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <GroupBox Header="基本配置"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <WrapPanel>
                                    <CheckBox x:Name="PerforatedPlanViewCheck"
                                              Margin="0,0,18,0"
                                              Foreground="#20242A"
                                              Content="生成俯视图" />
                                    <CheckBox x:Name="PerforatedSideViewCheck"
                                              Foreground="#20242A"
                                              Content="生成侧视图" />
                                </WrapPanel>
                            </GroupBox>

                            <GroupBox Margin="0,10,0,0"
                                      Header="规格参数 (mm)"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="板宽度" />
                                    <TextBox x:Name="PerforatedWidthBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="600" />
                                    <TextBlock Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="板高度" />
                                    <TextBox x:Name="PerforatedHeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="800" />

                                    <TextBlock Grid.Row="1" Margin="0,6,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="板深度" />
                                    <TextBox x:Name="PerforatedDepthBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource FormTextBoxStyle}" Text="18" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="内偏移" />
                                    <TextBox x:Name="PerforatedInnerOffsetBox" Grid.Row="1" Grid.Column="4" Margin="0,6,0,0" Style="{StaticResource FormTextBoxStyle}" Text="50" />

                                    <TextBlock Grid.Row="2" Margin="0,6,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="洞直径" />
                                    <TextBox x:Name="PerforatedHoleDiameterBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource FormTextBoxStyle}" Text="10" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Margin="0,10,0,0"
                                      Header="孔位阵列"
                                      Padding="10"
                                      BorderBrush="{StaticResource AccentBrush}"
                                      Foreground="{StaticResource AccentBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="横向孔数" />
                                    <TextBox x:Name="PerforatedHorizontalCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="6" />
                                    <TextBlock Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="纵向孔数" />
                                    <TextBox x:Name="PerforatedVerticalCountBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="10" />
                                </Grid>
                            </GroupBox>

                            <Button Margin="0,12,0,0"
                                    Height="38"
