                                    <TextBox x:Name="DoorPanelLeftExtensionBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="右盖 (mm)" />
