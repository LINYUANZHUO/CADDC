                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="左延伸" /><TextBox x:Name="BackboardLeftBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="5" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Text="右延伸" /><TextBox x:Name="BackboardRightBox" Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="5" />
