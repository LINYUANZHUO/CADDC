                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <TextBlock x:Name="StatisticsStatusText" Margin="10,0,10,8" VerticalAlignment="Bottom" Foreground="#68707C" TextWrapping="Wrap" IsHitTestVisible="False" />
        </Grid>

        <ScrollViewer x:Name="DrawingLayerModuleView"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <GroupBox Header="图层规范与清理" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <Button Style="{StaticResource DoorPanelCompactActionStyle}" Content="快速图层管理器 (TC)" Click="OnLayerManagerClick" />
                        <Button Margin="0,5,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Content="一键生成标准图层 (TCJZ)" Click="OnCreateStandardLayersClick" />
                        <Button Margin="0,5,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Content="一键智能归层 (TCGC)" Click="OnNormalizeLayersClick" />
                        <TextBlock Margin="0,6,0,3" Foreground="#E64B3C" TextWrapping="Wrap" Text="警告：深度清理会删除未使用的图层和块，请谨慎操作。" />
                        <Button Style="{StaticResource DoorPanelCompactActionStyle}" Background="#FFF0EE" BorderBrush="#F3AAA2" Foreground="#C92A1D" Content="图纸垃圾清理 (PU)" Click="OnPurgeDrawingClick" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="图层极速隔离显示" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button Style="{StaticResource DoorPanelCompactActionStyle}" Content="隐藏五金 (TCWJ)" Click="OnHideHardwareLayersClick" />
                        <Button Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="隐藏门板 (TCMB)" Click="OnHideDoorLayersClick" />
                        <Button Grid.Row="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="隐藏柜体 (TCHG)" Click="OnHideCabinetLayersClick" />
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="隐藏标注 (TCBZ)" Click="OnHideAnnotationLayersClick" />
                        <Button Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="显示所有图层 (TCXS)" Click="OnShowAllLayersClick" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="图纸显示修复" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="全局虚线比例" />
                        <TextBox x:Name="DrawingLinetypeScaleBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="40" />
                        <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="墙体填充比例" />
                        <TextBox x:Name="WallHatchScaleBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="1" />
                        <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="一键修复显示 (TXF)" Click="OnRepairDrawingDisplayClick" />
                    </Grid>
                </GroupBox>
                <TextBlock x:Name="DrawingLayerStatusText" Margin="0,6,0,0" Foreground="#68707C" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="OneClickFrameModuleView"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <GroupBox Header="1. 图框模板" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Foreground="#68707C" Text="选择 DWG 模板" />
                        <ComboBox x:Name="FrameTemplateCombo"
                                  Grid.Row="2"
                                  Style="{StaticResource DoorPanelCompactComboStyle}"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Content="📁"
                                ToolTip="选择外部 DWG 图框模板"
                                Click="OnBrowseFrameTemplateClick" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="2. 图框放置" Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <TextBlock Foreground="#68707C" Text="图形到图框的距离 (mm)" />
                        <TextBox x:Name="FrameMarginBox" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="50" />
