                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="上盖 (mm)" />
                                    <TextBox x:Name="DoorPanelTopExtensionBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#20242A" Text="下盖 (mm)" />
                                    <TextBox x:Name="DoorPanelBottomExtensionBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="左盖 (mm)" />
                                    <TextBox x:Name="DoorPanelLeftExtensionBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="右盖 (mm)" />
                                    <TextBox x:Name="DoorPanelRightExtensionBox" Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                </Grid>
                            </GroupBox>

                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#737B86"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="框选范围按柜体内空计算；上、下、左、右盖值分别向对应方向扩展门板。" />

                            <GroupBox Header="生成选项"
                                      Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="DoorPanelGenerateOpeningLinesCheck"
                                              Margin="0,2"
                                              Foreground="#20242A"
                                              IsChecked="True"
                                              Content="生成开门线（默认虚线）" />
                                    <CheckBox x:Name="DoorPanelGenerateMaskCheck"
                                              Margin="0,2"
                                              Foreground="#20242A"
                                              Content="生成门板背景遮罩 (Wipeout)" />
                                    <CheckBox x:Name="DoorPanelGenerateHingesCheck"
                                              Margin="0,2"
                                              Foreground="#20242A"
                                              IsChecked="True"
                                              Content="自动生成铰链" />
                                    <CheckBox x:Name="DoorPanelAvoidShelvesCheck"
                                              Margin="0,2"
                                              Foreground="#20242A"
                                              IsChecked="True"
                                              Content="自动识别层板并避让铰链" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="铰链设置" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="距门顶" />
                                    <TextBox x:Name="HingeTopOffsetBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="100" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#20242A" Text="距门底" />
                                    <TextBox x:Name="HingeBottomOffsetBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="100" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="H&lt;0.9m数" />
                                    <TextBox x:Name="HingeCountBelow900Box" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="2" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="0.9-1.5m数" />
                                    <TextBox x:Name="HingeCount900To1500Box" Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="3" />
                                    <TextBlock Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="1.5-2.0m数" />
                                    <TextBox x:Name="HingeCount1500To2000Box" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="4" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="2.0-2.5m数" />
                                    <TextBox x:Name="HingeCount2000To2500Box" Grid.Row="2" Grid.Column="4" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="5" />
                                    <TextBlock Grid.Row="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Text="H≥2.5m数" />
                                    <TextBox x:Name="HingeCountAtLeast2500Box" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="6" />
                                    <CheckBox x:Name="UseFixedHingeSpacingCheck" Grid.Row="3" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Foreground="#20242A" Content="固定间距" />
                                    <TextBox x:Name="FixedHingeSpacingBox" Grid.Row="3" Grid.Column="4" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="280" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="尺寸标注选项" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
