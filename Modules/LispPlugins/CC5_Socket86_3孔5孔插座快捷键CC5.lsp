;;; ---------------------------------------------------------------------
;;;  建块 / 插入
;;; ---------------------------------------------------------------------

;; 建块: 已存在就直接用(不重复定义), 返回块名
;; 基点 = 0,0,0  ->  插入时以外框左下角为插入点
(defun cc5:Define (name kind)
  (if (not (tblsearch "BLOCK" name))
    (progn
      (entmake (list '(0 . "BLOCK")
                     '(100 . "AcDbEntity")
                     '(8 . "0")
                     '(100 . "AcDbBlockBegin")
                     (cons 2 name)
                     '(70 . 0)
                     '(10 0.0 0.0 0.0)
                     (cons 3 name)))
      (if (= kind 3) (cc5:Geom3) (cc5:Geom5))
      (entmake '((0 . "ENDBLK")
                 (100 . "AcDbEntity")
                 (8 . "0")
                 (100 . "AcDbBlockEnd")))
    )
  )
  name
)

;; 插入: 直接 entmake 一个块参照, 不走 -INSERT 命令(无回显, 不闪屏)
;; 块参照放在当前图层上, 于是块内 0 层图元自动跟随当前图层颜色
(defun cc5:Insert (blk pt)
  (entmake (list '(0 . "INSERT")
                 '(100 . "AcDbEntity")
                 (cons 8 (getvar "CLAYER"))
                 '(100 . "AcDbBlockReference")
                 (cons 2 blk)
                 (cons 10 pt)
                 '(41 . 1.0)
                 '(42 . 1.0)
                 '(43 . 1.0)
                 '(50 . 0.0)))
)


;;; ---------------------------------------------------------------------
;;;  CC5 --- 连续插入插座
;;; ---------------------------------------------------------------------
(defun c:CC5 (/ b5 b3 three pt n5 n3)
  (setq b5 (cc5:Define "CC5-86五孔插座" 5)
        b3 (cc5:Define "CC5-86三孔插座" 3)
        three nil
        n5 0 n3 0)
  (while (progn
           (initget "S")
           (setq pt
             (getpoint
               (strcat "\n[" (if three "三孔" "五孔")
                       "] 指定插入点(外框左下角) 或 [S 改画"
                       (if three "五孔" "三孔")
                       "] <ESC 或回车 退出>: ")))
           (cond
             ;; 切换模式, 继续循环
             ((= pt "S")
              (setq three (not three))
              T)
             ;; 插入
             ((= (type pt) 'LIST)
              (if (cc5:Insert (if three b3 b5) pt)
                (if three (setq n3 (1+ n3)) (setq n5 (1+ n5)))
                (princ "\n  插入失败。")
              )
              T)
             ;; 回车 / ESC -> 结束
             (T nil)
           )
         )
  )
  (princ (strcat "\n[CC5] 本次共插入 五孔 " (itoa n5) " 个, 三孔 " (itoa n3) " 个。"))
  (princ)
)


