                                             Text="0" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#20242A" Text="右盖/终点 (mm)" />
                                    <TextBox x:Name="PlanDoorPanelRightExtensionBox"
                                             Grid.Column="4"
                                             Style="{StaticResource DoorPanelCompactInputStyle}"
                                             Text="0" />
                                </Grid>
                            </GroupBox>

