                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="俯视图间距" />
                                        <TextBox x:Name="CabinetPlanViewSpacingBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="400" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="侧视图间距" />
                                        <TextBox x:Name="CabinetSideViewSpacingBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="400" />
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="基础尺寸" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="宽 (W)" />
                                    <TextBox x:Name="CabinetWidthBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="900" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="高 (H)" />
                                    <TextBox x:Name="CabinetHeightBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="2100" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="深 (D)" />
                                    <TextBox x:Name="CabinetDepthBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="580" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Text="板厚 (T)" />
                                    <TextBox x:Name="CabinetThicknessBox" Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="18" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="侧板延伸（左 / 右）" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="左侧板延伸" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="上延伸" /><TextBox x:Name="CabinetLeftSideTopExtensionBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="下延伸" /><TextBox x:Name="CabinetLeftSideBottomExtensionBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                        <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="前延伸" /><TextBox x:Name="CabinetLeftSideFrontExtensionBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,4,0,0" VerticalAlignment="Center" Text="后延伸" /><TextBox x:Name="CabinetLeftSideRearExtensionBox" Grid.Row="1" Grid.Column="4" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    </Grid>
                                    <TextBlock Margin="0,7,0,0" FontWeight="SemiBold" Text="右侧板延伸" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="上延伸" /><TextBox x:Name="CabinetRightSideTopExtensionBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
