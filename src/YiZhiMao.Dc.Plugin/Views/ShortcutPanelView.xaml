                                    <TextBlock Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center" Text="中门档 (E2)" /><TextBox x:Name="FrameDoorMiddleFrameWidthBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="60" />
                                    <TextBlock Grid.Row="3" Margin="0,4,0,0" VerticalAlignment="Center" Text="下门档 (E3)" /><TextBox x:Name="FrameDoorBottomFrameWidthBox" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="60" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="进榫余量 (mm)" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="门档左右进榫 (G)" /><TextBox x:Name="FrameDoorRightFrameTenonBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="10" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="中门档进榫 (M)" /><TextBox x:Name="FrameDoorMiddleFrameTenonBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="10" />
                                    <TextBlock Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center" Text="芯板上进榫 (I)" /><TextBox x:Name="FrameDoorCoreTopTenonBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="8" />
                                    <TextBlock Grid.Row="3" Margin="0,4,0,0" VerticalAlignment="Center" Text="芯板下进榫 (J)" /><TextBox x:Name="FrameDoorCoreBottomTenonBox" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="8" />
                                    <TextBlock Grid.Row="4" Margin="0,4,0,0" VerticalAlignment="Center" Text="芯板左进榫 (K)" /><TextBox x:Name="FrameDoorCoreLeftTenonBox" Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="8" />
