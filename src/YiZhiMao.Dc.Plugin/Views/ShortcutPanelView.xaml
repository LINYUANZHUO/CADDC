<UserControl x:Class="YiZhiMao.Dc.Plugin.Views.ShortcutPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:YiZhiMao.Dc.Plugin.Views"
             Background="{DynamicResource ThemePageBrush}"
             FontFamily="Microsoft YaHei UI"
             MinWidth="0"
             MinHeight="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YiZhiMao.Dc.Plugin;component/Themes/ToolboxTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- 兼容现有页面中的资源键；颜色值仍由全局主题统一维护。 -->
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ThemeAccentColor}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ThemeAccentSoftColor}" />
        <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource ThemeBorderColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource ThemeTextSecondaryColor}" />

        <Style TargetType="TextBlock" BasedOn="{StaticResource DcTextBlockStyle}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource DcCheckBoxStyle}" />
        <Style TargetType="RadioButton" BasedOn="{StaticResource DcRadioButtonStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource DcComboBoxStyle}" />
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DcComboBoxItemStyle}" />
        <Style TargetType="ListBox" BasedOn="{StaticResource DcListBoxStyle}" />
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource DcListBoxItemStyle}" />
        <Style TargetType="Expander" BasedOn="{StaticResource DcExpanderStyle}" />
        <Style TargetType="Slider" BasedOn="{StaticResource DcSliderStyle}" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DcScrollBarStyle}" />
        <Style TargetType="GroupBox" BasedOn="{StaticResource DcGroupBoxStyle}" />
        <Style TargetType="TabControl" BasedOn="{StaticResource DcTabControlStyle}" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource DcDataGridStyle}" />

        <Style x:Key="FlatButtonStyle" TargetType="Button" BasedOn="{StaticResource DcButtonStyle}">
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <Style x:Key="ModuleButtonStyle" TargetType="Button" BasedOn="{StaticResource DcButtonStyle}">
            <Setter Property="Margin" Value="7,5,7,0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SelectedModuleButtonStyle" TargetType="Button" BasedOn="{StaticResource ModuleButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
        </Style>

        <Style x:Key="TopTabStyle" TargetType="TabItem" BasedOn="{StaticResource DcTabItemStyle}" />

        <Style x:Key="ShortcutRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DcDataGridRowStyle}" />

        <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DcDataGridCellStyle}" />

        <Style x:Key="AccentCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource ThemeAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MutedCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
        </Style>

        <Style x:Key="GridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource DcDataGridTextBlockStyle}" />

        <Style x:Key="MutedGridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource DcDataGridTextBlockStyle}">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="GridTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DcTextBoxStyle}">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DcTextBoxStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="30,0,10,0" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DcTextBoxStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,0" />
        </Style>

        <Style x:Key="HardwareInputStyle" TargetType="TextBox" BasedOn="{StaticResource DcTextBoxStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DoorPanelCompactGroupStyle" TargetType="GroupBox" BasedOn="{StaticResource DcCompactGroupBoxStyle}" />
        <Style x:Key="DoorPanelCompactInputStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource DcCompactTextBoxStyle}" />
        <Style x:Key="DoorPanelCompactComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DcCompactComboBoxStyle}" />
        <Style x:Key="DoorPanelCompactActionStyle"
               TargetType="Button"
               BasedOn="{StaticResource DcButtonStyle}">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style x:Key="PointStyleListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PointStyleBorder"
                                Background="{StaticResource ThemeSurfaceBrush}"
                                BorderBrush="{StaticResource ThemeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PointStyleBorder" Property="Background" Value="{StaticResource ThemeControlHoverBrush}" />
                                <Setter TargetName="PointStyleBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PointStyleBorder" Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
                                <Setter TargetName="PointStyleBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                                <Setter TargetName="PointStyleBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PointStyleBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ModuleNavigationColumn" Width="76" MinWidth="0" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition x:Name="ModuleContentColumn" Width="*" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#F0F1F3"
                BorderBrush="#D9DDE3"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <Button x:Name="PreferencesModuleButton"
                        Style="{StaticResource SelectedModuleButtonStyle}"
                        Click="OnPreferencesModuleClick">
                    <TextBlock Text="偏好设置"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="CabinetModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnCabinetModuleClick">
                    <TextBlock Text="柜体"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="BoardModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnBoardModuleClick">
                    <TextBlock Text="板件"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="DoorPanelModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnDoorPanelModuleClick">
                    <TextBlock Text="门板抽面"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="HardwareModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnHardwareModuleClick">
                    <TextBlock Text="五金件"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="WallPanelModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnWallPanelModuleClick">
                    <TextBlock Text="墙板"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="SmartAnnotationModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnSmartAnnotationModuleClick">
                    <TextBlock Text="智能标注"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="ImageModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnImageModuleClick">
                    <TextBlock Text="插入图片"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="OneClickFrameModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnOneClickFrameModuleClick">
                    <TextBlock Text="一键图框"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="BatchPrintModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnBatchPrintModuleClick">
                    <TextBlock Text="批量打印"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="SuperLibraryModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnSuperLibraryModuleClick">
                    <TextBlock Text="超级图库"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="StatisticsModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnStatisticsModuleClick">
                    <TextBlock Text="拆单统计"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="DrawingLayerModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnDrawingLayerModuleClick">
                    <TextBlock Text="图层图纸"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="RadialMenuModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnRadialMenuModuleClick">
                    <TextBlock Text="圆盘"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="LispMarketModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnLispMarketModuleClick">
                    <TextBlock Text="LISP市场"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="ShortcutModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnShortcutModuleClick">
                    <TextBlock Text="快捷键"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
            </StackPanel>
        </Border>

        <Thumb x:Name="ModuleNavigationSplitter"
               Grid.Column="1"
               Width="5"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Background="#D9DDE3"
               Cursor="SizeWE"
               Focusable="False"
               DragDelta="OnModuleNavigationSplitterDragDelta"
               ToolTip="拖动调整左侧功能区宽度">
            <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Grid Grid.Column="2">
        <ScrollViewer x:Name="PreferencesModuleView"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#F5F6F8">
            <StackPanel Margin="12,10,12,12">
                <TextBlock Text="偏好设置"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#20242A" />

                <TextBlock Margin="0,14,0,6"
                           Text="常规设置"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <Border Padding="12,10"
                        Background="White"
                        BorderBrush="#D9DDE3"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <CheckBox x:Name="AutoExpandSidebarCheckBox"
                                  Content="启动时自动展开侧边栏"
                                  FontWeight="SemiBold"
                                  Click="OnAutoExpandSidebarChanged" />
                        <TextBlock Margin="22,5,0,0"
                                   Foreground="#68707C"
                                   TextWrapping="Wrap"
                                   Text="关闭后插件仍会正常加载，需要时输入 DCS 打开工具箱。" />
                    </StackPanel>
                </Border>

                <Border Margin="0,8,0,0"
                        Padding="12,10"
                        Background="White"
                        BorderBrush="#D9DDE3"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <CheckBox x:Name="SmartInputMethodEnabledCheckBox"
                                  Content="启用智能输入法"
                                  FontWeight="SemiBold"
                                  Click="OnSmartInputMethodChanged" />
                        <TextBlock Margin="22,4,0,6"
                                   Foreground="#68707C"
                                   TextWrapping="Wrap"
                                   Text="仅响应 AutoCAD 绘图与文字编辑；不模拟按键，不控制插件面板和文件窗口。" />
                        <CheckBox x:Name="KeepCadCommandsEnglishCheckBox"
                                  Margin="22,3,0,0"
                                  Content="普通 CAD 操作保持英文"
                                  Click="OnSmartInputMethodChanged" />
                        <CheckBox x:Name="AutoChineseForTextCheckBox"
                                  Margin="22,5,0,0"
                                  Content="进入文字编辑自动切换中文"
                                  Click="OnSmartInputMethodChanged" />
                        <CheckBox x:Name="RestoreEnglishAfterTextCheckBox"
                                  Margin="22,5,0,0"
                                  Content="退出文字编辑恢复英文"
                                  Click="OnSmartInputMethodChanged" />
                    </StackPanel>
                </Border>

                <Expander x:Name="CadQuickToggleExpander"
                          Margin="0,8,0,0"
                          IsExpanded="False"
                          Expanded="OnCadQuickToggleExpanded">
                    <Expander.Header>
                        <TextBlock Text="CAD 快捷开关"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Expander.Header>
                    <Border Margin="0,6,0,0"
                            Padding="12,10"
                            Background="White"
                            BorderBrush="#D9DDE3"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <CheckBox x:Name="PointerInputCheckBox"
                                      Content="指针输入（P）"
                                      FontWeight="SemiBold"
                                      Click="OnPointerInputChanged" />
                            <TextBlock Margin="22,5,0,0"
                                       Foreground="#68707C"
                                       TextWrapping="Wrap"
                                       Text="实时切换 AutoCAD 动态输入中的指针输入，保留其他动态输入设置。" />
                            <Border Margin="0,10,0,8"
                                    BorderBrush="#E4E7EB"
                                    BorderThickness="0,1,0,0" />
                            <StackPanel>
                                <TextBlock Text="点样式"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="#68707C"
                                           Text="点击图标立即应用" />
                                <ListBox x:Name="PointStyleListBox"
                                         Margin="0,8,0,0"
                                         MaxWidth="250"
                                         HorizontalAlignment="Left"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         SelectedValuePath="Mode"
                                         SelectionChanged="OnPointStyleChanged"
                                         ItemContainerStyle="{StaticResource PointStyleListItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ToolTip="点样式快捷设置">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <views:PointStyleIcon Width="28"
                                                                  Height="28"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Mode="{Binding Mode}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <Border Margin="0,10,0,8"
                                    BorderBrush="#E4E7EB"
                                    BorderThickness="0,1,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="默认保存版本"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,8,0"
                                               Foreground="#68707C"
                                               Text="首次默认 AutoCAD 2007" />
                                </StackPanel>
                                <ComboBox x:Name="SaveFileFormatComboBox"
                                          Grid.Column="1"
                                          Width="210"
                                          Height="30"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Format"
                                          SelectionChanged="OnSaveFileFormatChanged"
                                          ToolTip="选择 AutoCAD 默认 DWG 保存版本" />
                            </Grid>
                            <Border Margin="0,10,0,8"
                                    BorderBrush="#E4E7EB"
                                    BorderThickness="0,1,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <CheckBox x:Name="AutoReplaceMissingShxCheckBox"
                                              Content="自动替换缺失文字 SHX"
                                              FontWeight="SemiBold"
                                              Click="OnAutoReplaceMissingShxChanged" />
                                    <TextBlock Margin="22,3,8,0"
                                               Foreground="#68707C"
                                               TextWrapping="Wrap"
                                               Text="默认开启；先匹配 Modules\Fonts，普通文字缺失改用 simplex.shx，中文大字体缺失改用 gbcbig.shx；形文件只提示。" />
                                    <Border Margin="0,8,0,8"
                                            BorderBrush="#E4E7EB"
                                            BorderThickness="0,1,0,0" />
                                    <CheckBox x:Name="SyncReferencedShxOnSaveCheckBox"
                                              Content="保存图纸时同步本图 SHX"
                                              FontWeight="SemiBold"
                                              Click="OnSyncReferencedShxOnSaveChanged" />
                                    <TextBlock Margin="22,3,8,0"
                                               Foreground="#68707C"
                                               TextWrapping="Wrap"
                                               Text="默认关闭；只从 Modules\Fonts 复制本图引用字体，冲突不覆盖。" />
                                </StackPanel>
                                <Button x:Name="ExportCurrentShxButton"
                                        Grid.Column="1"
                                        MinWidth="118"
                                        Height="30"
                                        Padding="10,0"
                                        VerticalAlignment="Center"
                                        Content="立即导出本图 SHX"
                                        Click="OnExportCurrentShxClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <TextBlock Margin="0,14,0,3"
                           Text="模块加载管理"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Margin="0,0,0,7"
                           Foreground="#68707C"
                           TextWrapping="Wrap"
                           Text="取消勾选后左侧入口会立即隐藏，对应命令也会停止执行；至少保留一个功能模块。" />
                <Border Background="White"
                        BorderBrush="#D9DDE3"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <CheckBox x:Name="AllModulesVisibleCheckBox"
                                  Margin="12,9,12,8"
                                  Content="全部显示"
                                  FontWeight="SemiBold"
                                  Click="OnShowAllModulesClick" />
                        <Border BorderBrush="#E4E7EB" BorderThickness="0,1,0,0" />
                        <Border Padding="12,8"
                                BorderBrush="#ECEEF1"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="偏好设置"
                                               FontWeight="SemiBold"
                                               Foreground="#20242A" />
                                    <TextBlock Margin="0,2,12,0"
                                               Text="常规设置与模块加载管理，始终保留"
                                               Foreground="#68707C"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox x:Name="PinnedPreferencesCheckBox"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          IsEnabled="False" />
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="ModulePreferenceItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8"
                                            BorderBrush="#ECEEF1"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#20242A" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding Description}"
                                                           Foreground="#68707C"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsEnabled}"
                                                      Click="OnModulePreferenceChanged" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PreferenceStatusText"
                           Margin="0,8,0,0"
                           Foreground="#68707C"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <TabControl x:Name="ShortcutModuleView"
                    Visibility="Collapsed"
                    Background="#F5F6F8"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource TopTabStyle}"
                    Padding="0">
            <TabItem Header="重命名快捷键">
                <Grid Margin="10,8,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid HorizontalAlignment="Stretch">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource SearchBoxStyle}"
                                 ToolTip="搜索功能说明、快捷键或底层命令"
                                 TextChanged="OnSearchTextChanged" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9AA1AA"
                                   IsHitTestVisible="False"
                                   Text="⌕" />
                        <TextBlock x:Name="SearchHint"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="#A0A6AF"
                                   IsHitTestVisible="False"
                                   Text="搜索功能或快捷键…" />
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,8,0,4">
                        <Button Margin="0,0,7,4"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#F1F8F2"
                                BorderBrush="#CDE5D2"
                                Foreground="#28833C"
                                Content="＋ 添加映射"
                                Click="OnAddMappingClick"
                                ToolTip="添加一行可编辑的新命令映射" />
                        <Button Margin="0,0,7,4"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#FFF3F2"
                                BorderBrush="#F0CECA"
                                Foreground="#C43B32"
                                Content="删除选中"
                                Click="OnDeleteSelectedClick"
                                ToolTip="删除选中的用户新增映射" />
                        <Button Margin="0,0,7,4"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#EEF6FF"
                                BorderBrush="#C8DDF5"
                                Foreground="#286FAE"
                                Content="导出 CSV"
                                Click="OnExportCsvClick"
                                ToolTip="导出全部快捷键映射为 CSV 文件" />
                    </WrapPanel>

                    <TextBlock Grid.Row="2"
                               Margin="2,0,0,7"
                               Foreground="#8A919B"
                               FontSize="11"
                               Text="提示：功能说明、默认和自定义均可双击编辑；仅底层命令只读；用户新增映射可删除。" />

                    <Border Grid.Row="3"
                            Background="White"
                            BorderBrush="#D9DDE3"
                            BorderThickness="1">
                        <DataGrid x:Name="ShortcutGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                                  VerticalGridLinesBrush="{StaticResource GridLineBrush}"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="32"
                                  RowStyle="{StaticResource ShortcutRowStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CellEditEnding="OnShortcutCellEditEnding"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="功能说明"
                                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource GridTextBoxStyle}"
                                                    Width="1.7*"
                                                    MinWidth="138" />
                                <DataGridTextColumn Header="默认"
                                                    Binding="{Binding DefaultAlias, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource GridTextBoxStyle}"
                                                    Width="0.8*"
                                                    MinWidth="72" />
                                <DataGridTextColumn Header="自定义"
                                                    Binding="{Binding CustomAlias, UpdateSourceTrigger=PropertyChanged}"
                                                    CellStyle="{StaticResource AccentCellStyle}"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    Width="0.9*"
                                                    MinWidth="82">
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="MinWidth" Value="68" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="禁用默认" Binding="{Binding DisableDefault}" Width="0.9*" MinWidth="82">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource DcCheckBoxStyle}">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource DcCheckBoxStyle}">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="底层命令"
                                                    Binding="{Binding CoreCommand}"
                                                    CellStyle="{StaticResource MutedCellStyle}"
                                                    ElementStyle="{StaticResource MutedGridTextBlockStyle}"
                                                    IsReadOnly="True"
                                                    Width="2*"
                                                    MinWidth="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Foreground="#68707C" TextWrapping="Wrap" />
                            <TextBlock Foreground="#8A919B"
                                       FontSize="11"
                                       Text="保存后将在当前图纸中立即应用；底层命令始终保留。" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="12,0,0,0"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="保存并应用快捷键"
                                Click="OnSaveClick" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="CAD命令大全">
                <Grid Margin="10,8,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid HorizontalAlignment="Stretch" Margin="0,0,0,8">
                        <TextBox x:Name="CadSearchBox"
                                 Style="{StaticResource SearchBoxStyle}"
                                 ToolTip="搜索快捷键、完整命令、功能说明或分类"
                                 TextChanged="OnCadSearchTextChanged" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9AA1AA"
                                   IsHitTestVisible="False"
                                   Text="⌕" />
                        <TextBlock x:Name="CadSearchHint"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="#A0A6AF"
                                   IsHitTestVisible="False"
                                   Text="搜索 CAD 命令或说明…" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#D9DDE3"
                            BorderThickness="1">
                        <DataGrid x:Name="CadCommandGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                                  VerticalGridLinesBrush="{StaticResource GridLineBrush}"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="32"
                                  RowStyle="{StaticResource ShortcutRowStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <Border Padding="8,6"
                                                                    Background="{StaticResource AccentSoftBrush}"
                                                                    BorderBrush="#F4C8B7"
                                                                    BorderThickness="0,1,0,1">
                                                                <TextBlock Foreground="{StaticResource AccentBrush}"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding Name}" />
                                                            </Border>
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="快捷键" Binding="{Binding Shortcut}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" Width="0.8*" MinWidth="138" />
                                <DataGridTextColumn Header="完整命令" Binding="{Binding FullCommand}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" Width="1.3*" MinWidth="168" />
                                <DataGridTextColumn Header="功能说明" Binding="{Binding Description}" ElementStyle="{StaticResource DcDataGridTextBlockStyle}" Width="1*" MinWidth="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <ScrollViewer x:Name="ImageModuleView"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="图片批量导入"
                          Padding="16,10,16,16"
                          BorderBrush="{StaticResource AccentBrush}"
                          Foreground="{StaticResource AccentBrush}">
                    <StackPanel MinWidth="290">
                        <TextBlock Margin="0,0,0,6"
                                   Foreground="#20242A"
                                   FontWeight="SemiBold"
                                   Text="排列间距：" />
                        <TextBox x:Name="ImageGapBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Text="50.0"
                                 ToolTip="相邻图片边界之间的图纸单位距离" />

                        <CheckBox x:Name="UseUnifiedHeightCheckBox"
                                  Margin="0,14,0,7"
                                  Foreground="#20242A"
                                  FontWeight="SemiBold"
                                  IsChecked="True"
                                  Content="启用统一像素高度" />
                        <TextBox x:Name="ImagePixelHeightBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Text="1000"
                                 ToolTip="图片会保持宽高比缩放" />

                        <Button Margin="0,16,0,0"
                                Height="38"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="批量插入图片 (DCOLE)"
                                Click="OnInsertImagesClick" />

                        <TextBlock x:Name="ImageStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="#68707C"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>
        <ScrollViewer x:Name="BatchPrintModuleView"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <GroupBox Header="快捷出图命令"
                          Padding="12"
                          BorderBrush="{StaticResource AccentBrush}"
                          Foreground="{StaticResource AccentBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="DCD1 选框打印纸张" Tag="DC_CMD_PRINT_PAPER" Click="OnRunPrintCommandClick" />
                        <Button Grid.Column="1" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="DCD2 选框打印 PDF" Tag="DC_CMD_PRINT_PDF" Click="OnRunPrintCommandClick" />
                        <Button Grid.Row="1" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="DCD3 布局打印纸张" Tag="DC_CMD_PRINT_LAYOUT_PAPER" Click="OnRunPrintCommandClick" />
                        <Button Grid.Row="1" Grid.Column="1" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="DCD4 布局打印 PDF" Tag="DC_CMD_PRINT_LAYOUT_PDF" Click="OnRunPrintCommandClick" />
                        <Button Grid.Row="2" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Content="绘制打印图框" Tag="DC_CMD_DRAW_PRINT_FRAME" Click="OnRunPrintCommandClick" />
                        <Button Grid.Row="2" Grid.Column="1" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Content="PDF 工具" Tag="DC_CMD_PDF_TOOL" Click="OnRunPrintCommandClick" />
                    </Grid>
                </GroupBox>

                <GroupBox Margin="0,12,0,0" Header="A. 输出设置" Padding="12" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}">
                    <StackPanel>
                        <CheckBox x:Name="PlotTransparencyCheck" Margin="0,3" Foreground="#20242A" Content="打印透明度" />
                        <CheckBox x:Name="PlotLineweightsCheck" Margin="0,3" Foreground="#20242A" Content="打印线宽" />
                        <CheckBox x:Name="OpenOutputFolderCheck" Margin="0,3" Foreground="#20242A" Content="批量打印单张后，打开所在文件夹" />
                        <CheckBox x:Name="OpenMergedPdfCheck" Margin="0,3" Foreground="#20242A" Content="PDF 合并完成后，打开该文件" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="#20242A" FontWeight="SemiBold" Text="PDF 输出模式：" />
                            <ComboBox x:Name="PdfOutputModeCombo"
                                      Grid.Column="1"
                                      Height="30"
                                      VerticalContentAlignment="Center"
                                      SelectedIndex="0">
                                <ComboBoxItem Tag="MergedOnly" Content="只生成合并 PDF" />
                                <ComboBoxItem Tag="SeparateOnly" Content="只生成所有单页 PDF" />
                                <ComboBoxItem Tag="SeparateAndMerged" Content="生成单页并加合并 PDF" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,12,0,0" Header="B. PDF/图像分辨率" Padding="12" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,5" VerticalAlignment="Center" Foreground="#20242A" Text="着色/光栅分辨率" />
                            <Slider x:Name="ImageDpiSlider" Grid.Column="1" Margin="10,0" Minimum="72" Maximum="4800" TickFrequency="72" ValueChanged="OnDpiSliderChanged" />
                            <TextBox x:Name="PrintImageDpiBox" Grid.Column="2" Height="28" VerticalContentAlignment="Center" />
                        </Grid>
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#737B86"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="该值直接应用于 AutoCAD 着色/光栅输出；矢量线条分辨率由所选 PC3 驱动配置控制。" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,12,0,0" Header="C. 识别规则" Padding="12" BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}">
                    <StackPanel>
                        <CheckBox x:Name="DetectPolylineCheck" Margin="0,3" Foreground="#20242A" Content="闭合矩形多段线" />
                        <CheckBox x:Name="DetectLooseLinesCheck" Margin="0,3" Foreground="#20242A" Content="四条直线组成的矩形" />
                        <CheckBox x:Name="DetectBlocksCheck" Margin="0,3" Foreground="#20242A" Content="块参照外框" />
                        <CheckBox x:Name="IgnoreEmptyFramesCheck" Margin="0,3" Foreground="#20242A" Content="忽略空白图框" />
                        <Button Margin="0,10,0,0" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="保存批量打印设置" Click="OnSavePrintSettingsClick" />
                        <TextBlock x:Name="PrintSettingsStatusText" Margin="0,8,0,0" Foreground="#68707C" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="DoorPanelModuleView" Visibility="Collapsed">
            <TabControl Background="#F5F6F8"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource TopTabStyle}"
                        Padding="0">
                <TabItem Header="立面门板">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8">
                            <GroupBox Header="门板参数设置"
                                      Margin="0"
                                      Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="尺寸计算模式" />
                                    <ComboBox x:Name="DoorPanelCalculationModeCombo"
                                               Grid.Column="1"
                                               Style="{StaticResource DoorPanelCompactComboStyle}"
                                               SelectedIndex="0">
                                        <ComboBoxItem Tag="DoorRoundedGapDistributed" Content="门取整，缝均分" />
                                        <ComboBoxItem Tag="GapRoundedDoorDistributed" Content="缝取整，门均分" />
                                        <ComboBoxItem Tag="DoorAndGapRoundedRemainderRight" Content="门和缝取整，余量留右" />
                                    </ComboBox>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="门板线条" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="#20242A" Text="线条颜色 (ACI)" />
                                    <ComboBox x:Name="DoorPanelColorBox" Grid.Column="1" IsEditable="True" Style="{StaticResource DoorPanelCompactComboStyle}" Text="3">
                                        <ComboBoxItem Content="3 - 绿色" /><ComboBoxItem Content="7 - 白色" /><ComboBoxItem Content="249 - 灰色" />
                                    </ComboBox>
                                    <Button Grid.Column="3" Style="{StaticResource DoorPanelCompactActionStyle}" Content="调色…" Click="OnDoorPanelColorClick" />
                                </Grid>
