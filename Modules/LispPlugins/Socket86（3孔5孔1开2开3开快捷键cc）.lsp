;;; ---------------------------------------------------------------------
;;;  建块 / 插入
;;; ---------------------------------------------------------------------

;; 图形种类 -> 中文名
(defun cc:ModeName (m)
  (cond ((= m 5)  "五孔")
        ((= m 3)  "三孔")
        ((= m 11) "单开")
        ((= m 12) "双开")
        ((= m 13) "三开")
        (T        "?")))

;; 图形种类 -> 块名
(defun cc:BlkName (m)
  (cond ((= m 5)  "CC-86五孔插座")
        ((= m 3)  "CC-86三孔插座")
        ((= m 11) "CC-86单开开关")
        ((= m 12) "CC-86双开开关")
        ((= m 13) "CC-86三开开关")))

;; 建块: 已存在就直接用(不重复定义), 返回块名
;; 基点 = 0,0,0  ->  插入时以外框左下角为插入点
;; kind: 5=五孔 3=三孔 11=单开 12=双开 13=三开
(defun cc:Define (name kind)
  (if (not (tblsearch "BLOCK" name))
    (progn
      (entmake (list '(0 . "BLOCK")
                     '(100 . "AcDbEntity")
                     '(8 . "0")
                     '(100 . "AcDbBlockBegin")
                     (cons 2 name)
                     '(70 . 0)
                     '(10 0.0 0.0 0.0)
                     (cons 3 name)))
      (cond ((= kind 5)  (cc:Geom5))
            ((= kind 3)  (cc:Geom3))
            ((= kind 11) (cc:GeomK1))
            ((= kind 12) (cc:GeomK2))
            ((= kind 13) (cc:GeomK3)))
      (entmake '((0 . "ENDBLK")
                 (100 . "AcDbEntity")
                 (8 . "0")
                 (100 . "AcDbBlockEnd")))
    )
  )
  name
)

;; 插入: 直接 entmake 一个块参照, 不走 -INSERT 命令(无回显, 不闪屏)
;; 块参照放在当前图层上, 于是块内 0 层图元自动跟随当前图层颜色
(defun cc:Insert (blk pt)
  (entmake (list '(0 . "INSERT")
                 '(100 . "AcDbEntity")
                 (cons 8 (getvar "CLAYER"))
                 '(100 . "AcDbBlockReference")
                 (cons 2 blk)
                 (cons 10 pt)
                 '(41 . 1.0)
                 '(42 . 1.0)
                 '(43 . 1.0)
                 '(50 . 0.0)))
)


;;; ---------------------------------------------------------------------
;;;  CC --- 连续插入插座 / 开关
;;; ---------------------------------------------------------------------
(defun c:CC (/ mode pt k blk counts n)
  (setq mode 5)                                    ;; 默认五孔
  (setq counts (list (cons 5 0) (cons 3 0) (cons 11 0) (cons 12 0) (cons 13 0)))
  (while (progn
           (initget "S C V B")
           (setq pt
             (getpoint
               (strcat "\n[" (cc:ModeName mode)
                       "] 指定插入点(外框左下角) 或 [S 五孔/三孔   C 单开   V 双开   B 三开]"
                       " <回车 或 ESC 退出>: ")))
           (cond
             ;; S: 五孔 <-> 三孔 来回切
             ((= pt "S") (setq mode (if (= mode 5) 3 5)) T)
             ;; C / V / B: 直接切到对应开关
             ((= pt "C") (setq mode 11) T)
             ((= pt "V") (setq mode 12) T)
             ((= pt "B") (setq mode 13) T)
             ;; 点: 插入当前图形(块按需创建)
             ((= (type pt) 'LIST)
              (setq blk (cc:Define (cc:BlkName mode) mode))
              (if (cc:Insert blk pt)
                (setq counts (subst (cons mode (1+ (cdr (assoc mode counts))))
                                    (assoc mode counts) counts))
                (princ "\n  插入失败。")
              )
              T)
             ;; 回车 / ESC -> 结束
             (T nil)
           )
         )
  )
  (setq n 0)
  (foreach k '(5 3 11 12 13)
    (setq n (+ n (cdr (assoc k counts)))))
  (if (= n 0)
    (princ "\n[CC] 未插入任何图块。")
    (progn
      (princ "\n[CC] 本次共插入:")
      (foreach k '(5 3 11 12 13)
        (if (> (cdr (assoc k counts)) 0)
          (princ (strcat " " (cc:ModeName k) " " (itoa (cdr (assoc k counts))) " 个;"))))
    )
  )
  (princ)
)


