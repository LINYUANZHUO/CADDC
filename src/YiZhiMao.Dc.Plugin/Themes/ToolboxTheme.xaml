<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 一只猫dc：橙灰品牌主题 -->
    <Color x:Key="ThemeAccentColor">#EF5E25</Color>
    <Color x:Key="ThemeAccentSoftColor">#FFF1EB</Color>
    <Color x:Key="ThemeBorderColor">#D9DDE3</Color>
    <Color x:Key="ThemeTextSecondaryColor">#68707C</Color>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccentColor}" />
    <SolidColorBrush x:Key="ThemeAccentSoftBrush" Color="{StaticResource ThemeAccentSoftColor}" />
    <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#DD4E18" />
    <SolidColorBrush x:Key="ThemeAccentPressedBrush" Color="#C94112" />
    <SolidColorBrush x:Key="ThemePageBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceAltBrush" Color="#F0F1F3" />
    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#20242A" />
    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="{StaticResource ThemeTextSecondaryColor}" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorderColor}" />
    <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#C8CDD4" />
    <SolidColorBrush x:Key="ThemeControlHoverBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="ThemeDisabledBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="ThemeInfoBrush" Color="#286FAE" />
    <SolidColorBrush x:Key="ThemeInfoSoftBrush" Color="#EEF6FF" />
    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#2E925B" />
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="#B56A18" />
    <SolidColorBrush x:Key="ThemeDangerBrush" Color="#C43B32" />

    <!-- 圆盘组件皮肤令牌：三圈颜色、交互高亮和分隔线集中管理。 -->
    <SolidColorBrush x:Key="RadialCadDarkInnerBrush" Color="#1F252C" />
    <SolidColorBrush x:Key="RadialCadDarkMiddleBrush" Color="#2A343D" />
    <SolidColorBrush x:Key="RadialCadDarkOuterBrush" Color="#374550" />
    <SolidColorBrush x:Key="RadialCadDarkAccentBrush" Color="#2DBAD2" />
    <SolidColorBrush x:Key="RadialCadDarkDividerBrush" Color="#6E7D8C" />
    <SolidColorBrush x:Key="RadialPurpleGrayInnerBrush" Color="#37323F" />
    <SolidColorBrush x:Key="RadialPurpleGrayMiddleBrush" Color="#4B4357" />
    <SolidColorBrush x:Key="RadialPurpleGrayOuterBrush" Color="#62586F" />
    <SolidColorBrush x:Key="RadialPurpleGrayAccentBrush" Color="#9A70D1" />
    <SolidColorBrush x:Key="RadialPurpleGrayDividerBrush" Color="#B8AEC5" />

    <Style x:Key="DcTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DcStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DcTextBlockStyle}">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DcButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="29" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.52" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DcButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ThemeAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DcInfoButtonStyle" TargetType="Button" BasedOn="{StaticResource DcButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ThemeInfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="#C8DDF5" />
        <Setter Property="Foreground" Value="{StaticResource ThemeInfoBrush}" />
    </Style>

    <Style x:Key="DcDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DcButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource ThemeDangerBrush}" />
    </Style>

    <Style x:Key="DcTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource ThemeAccentBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource ThemeAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="True" />
                        </Border>
                        <Border x:Name="FocusBorder"
                                BorderBrush="{StaticResource ThemeAccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="3"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource ThemeTextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputBorder" Property="Background" Value="{StaticResource ThemeDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
                            <Setter TargetName="InputBorder" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource ThemeDangerBrush}" />
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcCompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DcTextBoxStyle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="7,0" />
    </Style>

    <Style x:Key="DcComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SelectionMarker"
                                    Width="3"
                                    Margin="-9,-6,0,-6"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource ThemeAccentBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ThemeControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
                            <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DcComboBoxItemStyle}" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="DropDownToggle"
                                              Grid.ColumnSpan="2"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="SelectionContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="True" />
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="7,0,1,0"
                                         Padding="0"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         Style="{x:Null}"
                                         Visibility="Collapsed" />
                                <ToggleButton x:Name="EditableDropDownToggle"
                                              Grid.Column="1"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Visibility="Collapsed">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border Grid.Column="1"
                                        Width="1"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource ThemeBorderBrush}"
                                        IsHitTestVisible="False" />
                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      Width="9"
                                      Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0,0 L 4.5,4.5 L 9,0"
                                      Stroke="{StaticResource ThemeTextSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource ThemeSurfaceBrush}"
                                    BorderBrush="{StaticResource ThemeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <ScrollViewer Margin="2"
                                              CanContentScroll="True"
                                              SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource ThemeTextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="ComboBorder" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource ThemeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DropDownToggle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="EditableDropDownToggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ComboBorder" Property="Background" Value="{StaticResource ThemeDisabledBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
                            <Setter TargetName="ComboBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcCompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DcComboBoxStyle}">
        <Setter Property="Height" Value="27" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="DcCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckBorder"
                                Width="17"
                                Height="17"
                                Background="{StaticResource ThemeSurfaceBrush}"
                                BorderBrush="{StaticResource ThemeInputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="CheckMark"
                                      Width="10"
                                      Height="8"
                                      Data="M 0.5,3.5 L 3.5,6.5 L 9.5,0.5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                                <Rectangle x:Name="IndeterminateMark"
                                           Width="9"
                                           Height="2"
                                           Fill="White"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="7,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
                            <Setter TargetName="CheckBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RadioBorder"
                                Width="17"
                                Height="17"
                                Background="{StaticResource ThemeSurfaceBrush}"
                                BorderBrush="{StaticResource ThemeInputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="RadioMark"
                                     Width="9"
                                     Height="9"
                                     Fill="{StaticResource ThemeAccentBrush}"
                                     Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="7,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="RadioBorder" Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter TargetName="RadioMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RadioBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
                            <Setter TargetName="RadioBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ListItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ListItemBorder" Property="Background" Value="{StaticResource ThemeControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ListItemBorder" Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
                            <Setter TargetName="ListItemBorder" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DcListBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="ListBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" Padding="0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ListBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ListBorder" Property="Background" Value="{StaticResource ThemeDisabledBrush}" />
                            <Setter TargetName="ListBorder" Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcExpanderToggleStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="7,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Chevron"
                                  Width="7"
                                  Height="11"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,1 L 6,5.5 L 1,10"
                                  Stroke="{StaticResource ThemeTextSecondaryBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource ThemeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderToggle"
                                      Style="{StaticResource DcExpanderToggleStyle}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <Border x:Name="ContentBorder"
                                Grid.Row="1"
                                Margin="18,2,0,0"
                                Padding="0,3,0,0"
                                BorderBrush="{StaticResource ThemeBorderBrush}"
                                BorderThickness="1,0,0,0"
                                Visibility="Collapsed">
                            <ContentPresenter Margin="9,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentBorder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderToggle" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="ThumbCircle"
                             Fill="{StaticResource ThemeSurfaceBrush}"
                             Stroke="{StaticResource ThemeAccentBrush}"
                             StrokeThickness="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbCircle" Property="Fill" Value="{StaticResource ThemeAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbCircle" Property="Fill" Value="{StaticResource ThemeAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4"
                                Margin="7,0"
                                Background="{StaticResource ThemeBorderBrush}"
                                CornerRadius="2" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="{StaticResource ThemeAccentBrush}" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource DcSliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="MinWidth" Value="7" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ScrollThumb"
                            Margin="2"
                            Background="#B9BEC6"
                            CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource ThemeAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource ThemeAccentPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="DcVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource DcScrollBarThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="DcHorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource DcScrollBarThumbStyle}" MinWidth="22" MinHeight="7" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style x:Key="DcScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource DcVerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="11" />
                <Setter Property="Template" Value="{StaticResource DcHorizontalScrollBarTemplate}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Margin="0,8,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <Border Margin="10,0,0,0"
                                Padding="5,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{StaticResource ThemeSurfaceBrush}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcCompactGroupBoxStyle" TargetType="GroupBox" BasedOn="{StaticResource DcGroupBoxStyle}">
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
    </Style>

    <Style x:Key="DcTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="12,8,12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource ThemePageBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DcTabItemStyle}" />
    </Style>

    <Style x:Key="DcDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}" />
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcDataGridTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource DcTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="DcDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="31" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}" />
        <Setter Property="MinColumnWidth" Value="48" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ThemeBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ThemeBorderBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource ThemeSurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="#FFFDFB" />
        <Setter Property="RowStyle" Value="{StaticResource DcDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DcDataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DcDataGridColumnHeaderStyle}" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <!-- 合并主题后，未显式指定样式的基础控件也保持一致。 -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource DcTextBlockStyle}" />
    <Style TargetType="Button" BasedOn="{StaticResource DcButtonStyle}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource DcTextBoxStyle}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource DcComboBoxStyle}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DcComboBoxItemStyle}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource DcCheckBoxStyle}" />
    <Style TargetType="RadioButton" BasedOn="{StaticResource DcRadioButtonStyle}" />
    <Style TargetType="ListBox" BasedOn="{StaticResource DcListBoxStyle}" />
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DcListBoxItemStyle}" />
    <Style TargetType="Expander" BasedOn="{StaticResource DcExpanderStyle}" />
    <Style TargetType="Slider" BasedOn="{StaticResource DcSliderStyle}" />
    <Style TargetType="ScrollBar" BasedOn="{StaticResource DcScrollBarStyle}" />
    <Style TargetType="GroupBox" BasedOn="{StaticResource DcGroupBoxStyle}" />
    <Style TargetType="TabControl" BasedOn="{StaticResource DcTabControlStyle}" />
    <Style TargetType="DataGrid" BasedOn="{StaticResource DcDataGridStyle}" />
</ResourceDictionary>
