                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#20242A" Text="距门底" />
                                    <TextBox x:Name="HingeBottomOffsetBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="100" />
