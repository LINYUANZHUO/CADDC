<UserControl x:Class="YiZhiMao.Dc.Plugin.Views.ShortcutPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F8"
             FontFamily="Microsoft YaHei UI"
             MinWidth="430"
             MinHeight="320">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#EF5E25" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF1EB" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#D9DDE3" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#737B86" />

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Margin" Value="7,5,7,0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E4E8" />
            <Setter Property="Foreground" Value="#20242A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SelectedModuleButtonStyle" TargetType="Button" BasedOn="{StaticResource ModuleButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="TopTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#555D68" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="12,8,12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF8F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShortcutRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#20242A" />
            <Setter Property="Background" Value="White" />
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="#20242A" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MutedCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <Style x:Key="GridTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="30,6,10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8CDD4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8CDD4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="DoorPanelCompactGroupStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="DoorPanelCompactInputStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style x:Key="DoorPanelCompactComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="27" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="DoorPanelCompactActionStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92" MinWidth="78" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#F0F1F3"
                BorderBrush="#D9DDE3"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <Button x:Name="ShortcutModuleButton"
                        Style="{StaticResource SelectedModuleButtonStyle}"
                        Click="OnShortcutModuleClick">
                    <TextBlock Text="快捷键"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="ImageModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnImageModuleClick">
                    <TextBlock Text="插入图片"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="BatchPrintModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnBatchPrintModuleClick">
                    <TextBlock Text="批量打印"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="DoorPanelModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnDoorPanelModuleClick">
                    <TextBlock Text="门板抽面"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="HardwareModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnHardwareModuleClick">
                    <TextBlock Text="五金件"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="WallPanelModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnWallPanelModuleClick">
                    <TextBlock Text="墙板"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="BoardModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnBoardModuleClick">
                    <TextBlock Text="板件"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="StatisticsModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnStatisticsModuleClick">
                    <TextBlock Text="拆单统计"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="DrawingLayerModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnDrawingLayerModuleClick">
                    <TextBlock Text="图层图纸"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="OneClickFrameModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnOneClickFrameModuleClick">
                    <TextBlock Text="一键图框"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="RadialMenuModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnRadialMenuModuleClick">
                    <TextBlock Text="圆盘"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                <Button x:Name="LispMarketModuleButton"
                        Style="{StaticResource ModuleButtonStyle}"
                        Click="OnLispMarketModuleClick">
                    <TextBlock Text="LISP市场"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
            </StackPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#D9DDE3"
                      Cursor="SizeWE"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      ShowsPreview="True"
                      ToolTip="拖动调整左侧功能区宽度" />

        <Grid Grid.Column="2">
        <TabControl x:Name="ShortcutModuleView"
                    Background="#F5F6F8"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource TopTabStyle}"
                    Padding="0">
            <TabItem Header="重命名快捷键">
                <Grid Margin="10,8,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid MaxWidth="520" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox"
                                 MinWidth="260"
                                 Style="{StaticResource SearchBoxStyle}"
                                 ToolTip="搜索功能说明、快捷键或底层命令"
                                 TextChanged="OnSearchTextChanged" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9AA1AA"
                                   IsHitTestVisible="False"
                                   Text="⌕" />
                        <TextBlock x:Name="SearchHint"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="#A0A6AF"
                                   IsHitTestVisible="False"
                                   Text="搜索功能或快捷键…" />
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,8,0,4">
                        <Button Margin="0,0,7,4"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#F1F8F2"
                                BorderBrush="#CDE5D2"
                                Foreground="#28833C"
                                Content="＋ 添加映射"
                                Click="OnAddMappingClick"
                                ToolTip="添加一行可编辑的新命令映射" />
                        <Button Margin="0,0,7,4"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#FFF3F2"
                                BorderBrush="#F0CECA"
                                Foreground="#C43B32"
                                Content="删除选中"
                                Click="OnDeleteSelectedClick"
                                ToolTip="删除选中的用户新增映射" />
                        <Button Margin="0,0,7,4"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="#EEF6FF"
                                BorderBrush="#C8DDF5"
                                Foreground="#286FAE"
                                Content="导出 CSV"
                                Click="OnExportCsvClick"
                                ToolTip="导出全部快捷键映射为 CSV 文件" />
                    </WrapPanel>

                    <TextBlock Grid.Row="2"
                               Margin="2,0,0,7"
                               Foreground="#8A919B"
                               FontSize="11"
                               Text="提示：功能说明、默认和自定义均可双击编辑；仅底层命令只读；用户新增映射可删除。" />

                    <Border Grid.Row="3"
                            Background="White"
                            BorderBrush="#D9DDE3"
                            BorderThickness="1">
                        <DataGrid x:Name="ShortcutGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                                  VerticalGridLinesBrush="{StaticResource GridLineBrush}"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="32"
                                  RowStyle="{StaticResource ShortcutRowStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CellEditEnding="OnShortcutCellEditEnding"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="功能说明"
                                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource GridTextBoxStyle}"
                                                    Width="SizeToCells"
                                                    MinWidth="138" />
                                <DataGridTextColumn Header="默认"
                                                    Binding="{Binding DefaultAlias, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    EditingElementStyle="{StaticResource GridTextBoxStyle}"
                                                    Width="SizeToCells"
                                                    MinWidth="72" />
                                <DataGridTextColumn Header="自定义"
                                                    Binding="{Binding CustomAlias, UpdateSourceTrigger=PropertyChanged}"
                                                    CellStyle="{StaticResource AccentCellStyle}"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    Width="SizeToCells"
                                                    MinWidth="82">
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource GridTextBoxStyle}">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="MinWidth" Value="68" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="禁用默认" Binding="{Binding DisableDefault}" Width="SizeToCells" MinWidth="82">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="底层命令"
                                                    Binding="{Binding CoreCommand}"
                                                    CellStyle="{StaticResource MutedCellStyle}"
                                                    ElementStyle="{StaticResource GridTextBlockStyle}"
                                                    IsReadOnly="True"
                                                    Width="SizeToCells"
                                                    MinWidth="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Foreground="#68707C" TextWrapping="Wrap" />
                            <TextBlock Foreground="#8A919B"
                                       FontSize="11"
                                       Text="保存后将在当前图纸中立即应用；底层命令始终保留。" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="12,0,0,0"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="保存并应用快捷键"
                                Click="OnSaveClick" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="CAD命令大全">
                <Grid Margin="10,8,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBox x:Name="CadSearchBox"
                                 MinWidth="260"
                                 Style="{StaticResource SearchBoxStyle}"
                                 ToolTip="搜索快捷键、完整命令、功能说明或分类"
                                 TextChanged="OnCadSearchTextChanged" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9AA1AA"
                                   IsHitTestVisible="False"
                                   Text="⌕" />
                        <TextBlock x:Name="CadSearchHint"
                                   Margin="30,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="#A0A6AF"
                                   IsHitTestVisible="False"
                                   Text="搜索 CAD 命令或说明…" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#D9DDE3"
                            BorderThickness="1">
                        <DataGrid x:Name="CadCommandGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource GridLineBrush}"
                                  VerticalGridLinesBrush="{StaticResource GridLineBrush}"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="32"
                                  RowStyle="{StaticResource ShortcutRowStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <Border Padding="8,6"
                                                                    Background="{StaticResource AccentSoftBrush}"
                                                                    BorderBrush="#F4C8B7"
                                                                    BorderThickness="0,1,0,1">
                                                                <TextBlock Foreground="{StaticResource AccentBrush}"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding Name}" />
                                                            </Border>
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="快捷键" Binding="{Binding Shortcut}" Width="SizeToCells" MinWidth="138" />
                                <DataGridTextColumn Header="完整命令" Binding="{Binding FullCommand}" Width="SizeToCells" MinWidth="168" />
                                <DataGridTextColumn Header="功能说明" Binding="{Binding Description}" Width="SizeToCells" MinWidth="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <ScrollViewer x:Name="ImageModuleView"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="图片批量导入"
                          Padding="16,10,16,16"
                          BorderBrush="{StaticResource AccentBrush}"
                          Foreground="{StaticResource AccentBrush}">
                    <StackPanel MinWidth="290">
                        <TextBlock Margin="0,0,0,6"
                                   Foreground="#20242A"
                                   FontWeight="SemiBold"
                                   Text="排列间距：" />
                        <TextBox x:Name="ImageGapBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Text="50.0"
                                 ToolTip="相邻图片边界之间的图纸单位距离" />

                        <CheckBox x:Name="UseUnifiedHeightCheckBox"
                                  Margin="0,14,0,7"
                                  Foreground="#20242A"
                                  FontWeight="SemiBold"
                                  IsChecked="True"
                                  Content="启用统一像素高度" />
                        <TextBox x:Name="ImagePixelHeightBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Text="1000"
                                 ToolTip="图片会保持宽高比缩放" />

                        <Button Margin="0,16,0,0"
                                Height="38"
                                Style="{StaticResource FlatButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Content="批量插入图片 (OLE)"
                                Click="OnInsertImagesClick" />

                        <TextBlock x:Name="ImageStatusText"
                                   Margin="0,10,0,0"
                                   Foreground="#68707C"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>
        <ScrollViewer x:Name="BatchPrintModuleView"
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <GroupBox Header="快捷出图命令"
                          Padding="12"
                          BorderBrush="{StaticResource AccentBrush}"
                          Foreground="{StaticResource AccentBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="D1 选框打印纸张" Tag="DC_CMD_PRINT_PAPER" Click="OnRunPrintCommandClick" />
                        <Button Grid.Column="1" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="D2 选框打印 PDF" Tag="DC_CMD_PRINT_PDF" Click="OnRunPrintCommandClick" />
                        <Button Grid.Row="1" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="D3 布局打印纸张" Tag="DC_CMD_PRINT_LAYOUT_PAPER" Click="OnRunPrintCommandClick" />
                        <Button Grid.Row="1" Grid.Column="1" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="D4 布局打印 PDF" Tag="DC_CMD_PRINT_LAYOUT_PDF" Click="OnRunPrintCommandClick" />
                        <Button Grid.Row="2" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Content="绘制打印图框" Tag="DC_CMD_DRAW_PRINT_FRAME" Click="OnRunPrintCommandClick" />
                        <Button Grid.Row="2" Grid.Column="1" Margin="3" Height="32" FontSize="11" Padding="2,0" Style="{StaticResource FlatButtonStyle}" Content="PDF 工具" Tag="DC_CMD_PDF_TOOL" Click="OnRunPrintCommandClick" />
                    </Grid>
                </GroupBox>

