                                    <CheckBox x:Name="CabinetGenerateElevationCheck" IsChecked="True" Content="生成正视图" />
                                    <CheckBox x:Name="CabinetGeneratePlanCheck" Grid.Column="1" IsChecked="True" Content="生成俯视图" />
                                    <CheckBox x:Name="CabinetGenerateSideCheck" Grid.Column="2" IsChecked="True" Content="生成侧视图" />
                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0">
