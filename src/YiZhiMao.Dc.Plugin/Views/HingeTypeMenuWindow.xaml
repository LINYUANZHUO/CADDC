<Window x:Class="YiZhiMao.Dc.Plugin.Views.HingeTypeMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="164"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Microsoft YaHei UI"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/YiZhiMao.Dc.Plugin;component/Themes/ToolboxTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource DcButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource ThemePageBrush}"
            BorderBrush="{StaticResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="3"
            Padding="4">
        <StackPanel>
            <TextBlock Margin="8,5,8,4"
                       Foreground="{StaticResource ThemeTextSecondaryBrush}"
                       FontSize="12"
                       Text="选择铰链类型" />
            <Button Content="内嵌 (D)" Tag="内嵌" Click="OnTypeClick" />
            <Button Content="半盖 (X)" Tag="半盖" Click="OnTypeClick" />
            <Button x:Name="FullCoverButton"
                    Content="全盖 (Z)"
                    Tag="全盖"
                    Background="{StaticResource ThemeAccentBrush}"
                    BorderBrush="{StaticResource ThemeAccentBrush}"
                    Foreground="White"
                    Click="OnTypeClick" />
        </StackPanel>
    </Border>
</Window>
