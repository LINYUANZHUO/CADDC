<Window x:Class="YiZhiMao.Dc.Plugin.Views.BatchPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一只猫dc 批量打印中心"
        Width="820"
        Height="560"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#EF5E25" />
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="8" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" CornerRadius="3">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="批量操作：" />
                <TextBlock Margin="4,0" VerticalAlignment="Center" Text="份数" />
                <TextBox x:Name="BulkCopiesBox" Width="52" Height="28" VerticalContentAlignment="Center" Text="1" />
                <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" Text="纸张" />
                <ComboBox x:Name="BulkPaperCombo" Width="245" Height="28" IsEditable="True" />
                <Button Style="{StaticResource ActionButton}" Content="应用到选中" Click="OnApplyBulkClick" />
                <Button Style="{StaticResource ActionButton}" Foreground="#C43B32" Content="删除选中" Click="OnDeleteSelectedClick" />
            </WrapPanel>
        </Border>

        <DataGrid x:Name="JobGrid"
                  Grid.Row="1"
                  Margin="0,10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#D9DDE3"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="勾选" Binding="{Binding IsSelected}" Width="54" />
                <DataGridTextColumn Header="序号" Binding="{Binding Index}" IsReadOnly="True" Width="56" />
                <DataGridTemplateColumn Header="预览" Width="66">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Padding="8,3" Content="查看" Click="OnPreviewClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="打印份数" Binding="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                <DataGridTemplateColumn Header="删除" Width="62">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Padding="8,3" Foreground="#C43B32" Content="删除" Click="OnDeleteRowClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="纸张尺寸" Binding="{Binding Paper, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                <DataGridTextColumn Header="图面尺寸 (CAD)" Binding="{Binding DrawingSize}" IsReadOnly="True" Width="130" />
                <DataGridTextColumn Header="备注/布局" Binding="{Binding Notes}" IsReadOnly="True" Width="*" MinWidth="130" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="打印设备：" />
            <ComboBox x:Name="PrinterCombo" Grid.Column="1" Height="28" SelectionChanged="OnPrinterChanged" />
            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="打印样式：" />
            <ComboBox x:Name="PlotStyleCombo" Grid.Column="3" Height="28" IsEditable="True" />
            <TextBlock Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Text="页边留白：" />
            <TextBox x:Name="MarginBox" Grid.Column="5" Height="28" VerticalContentAlignment="Center" />
            <CheckBox x:Name="CollateCheck" Grid.Column="6" Margin="12,0,0,0" VerticalAlignment="Center" Content="逐份打印" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#68707C" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ActionButton}" Background="#EEF6FF" BorderBrush="#C8DDF5" Foreground="#286FAE" Content="全部预览" Click="OnPreviewAllClick" />
                <Button x:Name="StartButton" Style="{StaticResource ActionButton}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Click="OnStartClick" />
                <Button Style="{StaticResource ActionButton}" Content="取消" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
