                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Button Style="{StaticResource DoorPanelCompactActionStyle}" Content="拆分板件 (DCFG)" Click="OnSplitBoardClick" />
                                    <Button Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="合并板件 (DCHB)" Click="OnMergeBoardsClick" />
                                    <Button Grid.Row="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="延伸线/矩形 (DCEXX)" Click="OnExtendBoardClick" />
                                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="修剪线/矩形 (DCTRR)" Click="OnTrimBoardClick" />
                                    <Button Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="层板投影 (DCFS)" Click="OnShelfProjectClick" />
                                </Grid>
                            </GroupBox>
                            <TextBlock x:Name="BoardStatusText" Margin="0,6,0,0" Foreground="#68707C" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="单双线">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
