                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#20242A" Text="横向排数" />
                                        <ComboBox x:Name="BackgroundWallRowCountCombo"
                                                  Grid.Column="1"
                                                  Height="30"
                                                  VerticalContentAlignment="Center"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnBackgroundWallRowCountChanged">
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                            <ComboBoxItem Content="3" />
                                            <ComboBoxItem Content="4" />
                                            <ComboBoxItem Content="5" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Margin="0,10,0,4" Foreground="#68707C" Text="列表顺序由下往上；首排为底、末排为顶，中间排为中。" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="68" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="68" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="#68707C" Text="列数" />
                                        <TextBlock Grid.Column="4" HorizontalAlignment="Center" Foreground="#68707C" Text="高度" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="68" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="68" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow1Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第一排(底)" />
                                        <TextBox x:Name="BackgroundWallRow1ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow1HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow2Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第二排" />
                                        <TextBox x:Name="BackgroundWallRow2ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow2HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow3" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow3Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第三排" />
                                        <TextBox x:Name="BackgroundWallRow3ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow3HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow4" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow4Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第四排" />
                                        <TextBox x:Name="BackgroundWallRow4ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow4HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                    <Grid x:Name="BackgroundWallRow5" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="68" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundWallRow5Label" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#20242A" Text="第五排" />
                                        <TextBox x:Name="BackgroundWallRow5ColumnCountBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" Text="4" />
                                        <TextBox x:Name="BackgroundWallRow5HeightBox" Grid.Column="4" Style="{StaticResource FormTextBoxStyle}" Text="700" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <Button Margin="0,12,0,0"
                                    Height="38"
                                    Style="{StaticResource FlatButtonStyle}"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Content="生成背景墙 (DCBJQ)"
                                    Click="OnDrawBackgroundWallClick" />
                            <TextBlock x:Name="BackgroundWallStatusText"
                                       Margin="0,8,0,0"
                                       Foreground="#68707C"
                                       TextWrapping="Wrap"
                                       Text="俯视大板与立面板缝保持一致；卡槽按板缝中心生成，末块板不生成卡槽。" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <ScrollViewer x:Name="SmartAnnotationModuleView"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <GroupBox Header="样式库配置"
                          Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <CheckBox x:Name="SmartAnnotationUseTemplateCheck"
                                  IsChecked="True"
                                  Content="使用雷神标注样式" />
                        <TextBlock Margin="0,6,0,3" Foreground="#68707C" Text="选择样式模板文件" />
                        <ComboBox x:Name="SmartAnnotationTemplateCombo"
                                  Height="30"
                                  DisplayMemberPath="Name" />
                        <Button Margin="0,6,0,0"
                                Height="28"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Content="打开模板文件夹"
                                Click="OnOpenDimTemplateFolderClick" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="间距设置"
                          Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="内层偏移 (mm)" />
                        <TextBox x:Name="SmartAnnotationInnerOffsetBox"
                                 Grid.Column="1"
                                 Style="{StaticResource DoorPanelCompactInputStyle}"
                                 Text="160" />
                        <TextBlock Grid.Row="1" Margin="0,5,0,0" VerticalAlignment="Center" Text="外层总尺寸偏移 (mm)" />
                        <TextBox x:Name="SmartAnnotationOuterOffsetBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,5,0,0"
                                 Style="{StaticResource DoorPanelCompactInputStyle}"
                                 Text="240" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="标注过滤配置"
                          Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <CheckBox x:Name="SmartAnnotationFullGraphicCheck"
                                  Content="全图形标注模式（纯净模式，忽略图层和板厚规则）" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SmartAnnotationFilterThicknessCheck"
                                      VerticalAlignment="Center"
                                      IsChecked="True"
                                      Content="板厚过滤" />
                            <TextBox x:Name="SmartAnnotationFilterThicknessBox"
                                     Grid.Column="1"
                                     Style="{StaticResource DoorPanelCompactInputStyle}"
                                     Text="18" />
                            <CheckBox x:Name="SmartAnnotationFilterMinimumCheck"
                                      Grid.Column="3"
                                      VerticalAlignment="Center"
                                      IsChecked="True"
                                      Content="小于不标" />
                            <TextBox x:Name="SmartAnnotationMinimumBox"
                                     Grid.Column="4"
                                     Style="{StaticResource DoorPanelCompactInputStyle}"
                                     Text="1" />
                        </Grid>
                        <CheckBox x:Name="SmartAnnotationMergeOverlapCheck"
                                  Margin="0,5,0,0"
                                  Content="柜体标注合并重叠图形" />
                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock Margin="0,2,6,0" Text="对象过滤：" />
                            <CheckBox x:Name="SmartAnnotationFilterPointCheck" Margin="0,0,8,0" Content="点" />
                            <CheckBox x:Name="SmartAnnotationFilterLineCheck" Margin="0,0,8,0" Content="线条" />
                            <CheckBox x:Name="SmartAnnotationFilterDashedCheck" Margin="0,0,8,0" Content="虚线" />
                            <CheckBox x:Name="SmartAnnotationFilterPolylineCheck" Margin="0,0,8,0" Content="多段线" />
                            <CheckBox x:Name="SmartAnnotationFilterArcCheck" Margin="0,0,8,0" Content="圆弧" />
                            <CheckBox x:Name="SmartAnnotationFilterTextCheck" Margin="0,0,8,0" IsChecked="True" Content="文字" />
                            <CheckBox x:Name="SmartAnnotationFilterBlockCheck" Margin="0,0,8,0" Content="图块" />
                            <CheckBox x:Name="SmartAnnotationFilterHatchCheck" Content="填充" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="柜体柜门标注"
                          Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <UniformGrid Columns="2">
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="柜体标注 (DCBC)" Click="OnDimensionCabinetClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="门板标注 (DCBM)" Click="OnDimensionPanelClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="左下标注 (DCBZ)" Click="OnDimensionLeftBottomClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="右上标注 (DCBY)" Click="OnDimensionRightTopClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="内空标注 (DCBN)" Click="OnDimensionInnerClick" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="智能标注"
                          Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <UniformGrid Columns="2">
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="单边标注 (DCBD)" Click="OnDimensionSingleClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="连续标注 (DCBL)" Click="OnDimensionContinueClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="智能对象 (DCBDX)" Click="OnDimensionSmartObjectClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="批量动态标注 (DCBP)" Click="OnDimensionBatchDynamicClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="选择标注[动态] (DCBX)" Click="OnDimensionSelectDynamicClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="批量对齐 (DCBAA)" Click="OnDimensionAlignBatchClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="连续对齐 (DCBAC)" Click="OnDimensionAlignContinueClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="外围线条标注 (DCBWW)" Click="OnDimensionOuterClick" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="标注修改"
                          Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <UniformGrid Columns="2">
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="标注缩放 (DCBS)" Click="OnDimensionScaleClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="标注分割 (DCBF)" Click="OnDimensionSplitClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="标注对齐 (DCBDQ)" Click="OnDimensionAlignClick" />
                        <Button Margin="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="合并标注 (DCBJ)" Click="OnDimensionJoinClick" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="清理标注"
                          Style="{StaticResource DoorPanelCompactGroupStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SmartAnnotationDeleteThicknessCheck"
                                      VerticalAlignment="Center"
                                      Content="清除板厚" />
                            <TextBox x:Name="SmartAnnotationDeleteThicknessBox"
                                     Grid.Column="1"
                                     Style="{StaticResource DoorPanelCompactInputStyle}"
                                     Text="50" />
                        </Grid>
                        <Button Margin="0,6,0,0"
                                Height="34"
                                Style="{StaticResource DoorPanelCompactActionStyle}"
                                Background="#F45B2A"
                                BorderBrush="#F45B2A"
                                Foreground="White"
                                Content="清除所有标注 (DCBQ)"
                                Click="OnDimensionDeleteAllClick" />
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="SmartAnnotationStatusText"
                           Margin="0,4,0,8"
                           Foreground="#68707C"
                           TextWrapping="Wrap"
                           Text="执行命令前会安全同步模板标注样式，并复用已安装雷神工具箱的标注命令。" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="CabinetModuleView" Visibility="Collapsed">
            <TabControl Background="#F5F6F8">
                <TabItem Header="标准单元柜">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
