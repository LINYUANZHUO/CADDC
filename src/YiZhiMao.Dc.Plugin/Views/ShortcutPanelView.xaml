                                    <TextBlock Grid.Row="3" Margin="0,4,0,0" VerticalAlignment="Center" Text="门芯板厚度 (F)" /><TextBox x:Name="FrameDoorCoreThicknessBox" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="12" />
