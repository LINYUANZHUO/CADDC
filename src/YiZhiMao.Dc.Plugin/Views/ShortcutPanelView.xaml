                            <GroupBox Header="单双三线偏移" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="偏移板厚 (mm)" />
                                    <TextBox x:Name="BoardLineThicknessBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="18" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="双线模式" />
                                    <ComboBox x:Name="BoardDoubleModeCombo" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Height="30" SelectedIndex="0"><ComboBoxItem Content="生成线" Tag="Line" /><ComboBoxItem Content="生成矩形" Tag="Rectangle" /></ComboBox>
                                    <TextBlock Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center" Text="三线模式" />
                                    <ComboBox x:Name="BoardTripleModeCombo" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Height="30" SelectedIndex="0"><ComboBoxItem Content="生成线" Tag="Line" /><ComboBoxItem Content="生成矩形" Tag="Rectangle" /></ComboBox>
                                    <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource DoorPanelCompactActionStyle}" Content="单线 (DC1)" Click="OnBoardSingleLineClick" />
                                        <Button Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Content="双线 (DC2)" Click="OnBoardDoubleLineClick" />
                                        <Button Grid.Column="4" Style="{StaticResource DoorPanelCompactActionStyle}" Content="三线 (DC3)" Click="OnBoardTripleLineClick" />
                                    </Grid>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="单线变双/三线" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="上延伸 (mm)" />
                                    <TextBox x:Name="BoardExtendStartBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="下延伸 (mm)" />
                                    <TextBox x:Name="BoardExtendEndBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="0" />
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="单线变双 (DCZ2)" Click="OnBoardLineToDoubleClick" />
                                        <Button Grid.Column="2" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="单线变三 (DCZ3)" Click="OnBoardLineToTripleClick" />
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="组件">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8">
                            <GroupBox Header="组件公共设置" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="酒架深度 (mm)" /><TextBox x:Name="WineRackDepthBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="500" /></Grid>
                            </GroupBox>
                            <GroupBox Header="十字酒架" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="横板数" /><TextBox x:Name="WineRowsBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="3" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="竖板数" /><TextBox x:Name="WineColumnsBox" Grid.Column="4" Style="{StaticResource DoorPanelCompactInputStyle}" Text="3" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="板厚 (mm)" /><TextBox x:Name="WineCrossThicknessBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="18" />
                                    <Button Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="生成十字酒架 (DCJJ)" Click="OnCrossWineRackClick" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="45°斜酒架" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="板厚 (mm)" /><TextBox x:Name="WineDiagonalThicknessBox" Grid.Column="1" Style="{StaticResource DoorPanelCompactInputStyle}" Text="12" />
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="内格净宽 (mm)" /><TextBox x:Name="WineCellWidthBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Style="{StaticResource DoorPanelCompactInputStyle}" Text="100" />
                                    <Button Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="生成斜酒架 (DCJX)" Click="OnDiagonalWineRackClick" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid x:Name="StatisticsModuleView" Visibility="Collapsed">
            <TabControl Background="#F5F6F8">
                <TabItem Header="全屋拆单">
                    <StackPanel Margin="8">
                        <GroupBox Header="一键全屋拆单" Style="{StaticResource DoorPanelCompactGroupStyle}">
                            <StackPanel>
                                <TextBlock Foreground="#68707C" TextWrapping="Wrap" Text="自动扫描模型空间中的柜体板件、门板与五金，选择放置CAD表格或导出Excel总表。" />
                                <Button Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="一键全屋拆单 (DCQW)" Click="OnWholeHouseStatisticsClick" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
                <TabItem Header="部件统计">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8">
                            <GroupBox Header="统计范围" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="#68707C" TextWrapping="Wrap" Text="框选柜体板件、门板与五金，按图层和块名称归类，相同规格自动合并数量。" />
                                    <Button Margin="0,6,0,0" Style="{StaticResource DoorPanelCompactActionStyle}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White" Content="导出部件统计 (DCCD)" Click="OnPartsStatisticsClick" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
