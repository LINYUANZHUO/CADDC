                                              Margin="0,2"
                                              Foreground="#20242A"
                                              IsChecked="True"
                                              Content="自动识别层板并避让铰链" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="铰链设置" Style="{StaticResource DoorPanelCompactGroupStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
